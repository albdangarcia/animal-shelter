# Silences dotenv v17's promotional "tip" lines on every command that loads
# env files (prisma, playwright, npm scripts).
DOTENV_CONFIG_QUIET=true

# ==================================
# === CORE APPLICATION SECRETS ===
# ==================================
# Generate with `openssl rand -base64 32`.
# Use a DIFFERENT value for each environment (local, preview, production).
# Sharing one means a session issued by any of them is valid on all of them.
BETTER_AUTH_SECRET=""

# Fallback base URL, used when a request has no host to derive one from.
# Full URL with scheme, no trailing slash, and no "/api/auth" suffix —
# Better Auth appends its own base path.
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated allowlist of hosts the app may be served from. The host is
# taken from the incoming request and matched against this list, so a single
# deployment can answer on several URLs. Hosts only — no scheme, no path.
# Supports exact matches, wildcards, and port wildcards (`localhost:*`).
#
# Local:      localhost:*
# Production: your-app.vercel.app
# Preview:    your-app-*-your-vercel-scope.vercel.app
#
# Keep preview patterns scoped to your own Vercel team. A bare *.vercel.app
# would trust every application on the platform, not just yours.
BETTER_AUTH_ALLOWED_HOSTS="localhost:*"

# Password for the default admin user created during database seeding
ADMIN_PASSWORD=""

# Vercel Blob Storage token (required for image uploads)
BLOB_READ_WRITE_TOKEN=""

# (Optional) GitHub OAuth credentials for user login.
# Register the callback URL http://localhost:3000/api/auth/callback/github on
# your OAuth App. A GitHub OAuth App accepts only one callback URL, so use a
# separate App per environment (local, production).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# (Optional) Google OAuth credentials for user login.
# Register the callback URL http://localhost:3000/api/auth/callback/google on
# your OAuth client. One client can hold multiple redirect URIs, but a
# separate client per environment (local, production) is recommended.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ==================================
# === DATABASE CONNECTION      ===
# ==================================
# DATABASE_URL is the pooled connection the running app uses. DATABASE_URL_UNPOOLED
# is the direct connection migrations and seeding require — Prisma Migrate breaks
# against a PgBouncer transaction-mode pooler. Locally the two are identical: a
# plain Postgres container has no pooler. On Neon (Vercel) they diverge — the
# pooled host carries a `-pooler` suffix, the direct one does not — so replace
# both with the connection strings from your provider. Format:
#   postgresql://<user>:<password>@<host>:<port>/<database>

DATABASE_URL="postgresql://postgres:mysecretpassword@127.0.0.1:5432/postgres"
DATABASE_URL_UNPOOLED="postgresql://postgres:mysecretpassword@127.0.0.1:5432/postgres"

# ==================================
# === Seeding                    ===
# ==================================
# Local development only. When set, gives one seeded walk-in person this email
# address, so signing in with an OAuth account whose *verified* email matches
# will link that account to the existing person record instead of creating a
# new one. Used to exercise the account-to-person linking rule end to end.
# Leave unset in any shared or deployed environment — it seeds a real address.
# DEV_LINK_TEST_EMAIL=""

# ==================================
# === Reporting                  ===
# ==================================
# IANA timezone the shelter operates in. All report date-range boundaries are
# computed in this zone so every viewer sees identical numbers. Defaults to
# "America/New_York" when unset.
SHELTER_TIMEZONE="America/New_York"

# ==================================
# === Demo Setup                 ===
# ==================================
# Flag for demo, it will show the demo banner and different
# implementation for uploading the animal images
NEXT_PUBLIC_IS_DEMO=false
# Secret to reset the data for the demo
CRON_SECRET=""

# ==================================
# === AI Staff Chat              ===
# ==================================
# API key for the Groq provider (@ai-sdk/groq) — the provider `app/lib/ai/
# provider.ts` exports. Get one from https://console.groq.com/keys
GROQ_API_KEY=""

# "free" (default, and unset), "paid", or "free-synthetic".
#
# Free provider tiers retain prompts and tool results for training and human
# review, which is only acceptable against a synthetic database:
#   - "free": the AI provider module refuses to initialise unless DATABASE_URL
#     points at a local/private database, derived from the URL — the only path
#     that verifies anything, and why a forgotten deployment fails closed.
#   - "paid": a paid API key whose traffic is not retained for training; any
#     database is then allowed.
#   - "free-synthetic": a free key against a networked database the operator
#     certifies holds only seeded data. Nothing verifies this — set it only on
#     a demo deployment.
AI_PROVIDER_TIER="free"

# HMAC secret the AI SDK uses to sign write-tool approval requests. In the chat
# pattern the server rebuilds the conversation from client-sent messages each
# turn, so an approval is client-controlled input on replay — signing binds it
# to the exact tool, call id, and arguments that were approved. Generate with
# `openssl rand -base64 32`, use a different value per environment. Required
# once a write tool (setTaskStatus) is in the caller's set: the chat route
# refuses those requests rather than run with unsigned approvals if it's unset.
AI_TOOL_APPROVAL_SECRET=""
