# ==================================
# === CORE APPLICATION SECRETS ===
# ==================================
# Generate with `openssl rand -base64 32`.
# Use a DIFFERENT value for each environment (local, preview, production).
# Sharing one means a session issued by any of them is valid on all of them.
BETTER_AUTH_SECRET=""

# Fallback base URL, used when a request has no host to derive one from.
# Full URL with scheme, no trailing slash, and no "/api/auth" suffix —
# Better Auth appends its own base path.
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated allowlist of hosts the app may be served from. The host is
# taken from the incoming request and matched against this list, so a single
# deployment can answer on several URLs. Hosts only — no scheme, no path.
# Supports exact matches, wildcards, and port wildcards (`localhost:*`).
#
# Local:      localhost:*
# Production: your-app.vercel.app
# Preview:    your-app-*-your-vercel-scope.vercel.app
#
# Keep preview patterns scoped to your own Vercel team. A bare *.vercel.app
# would trust every application on the platform, not just yours.
BETTER_AUTH_ALLOWED_HOSTS="localhost:*"

# Password for the default admin user created during database seeding
ADMIN_PASSWORD=""

# Vercel Blob Storage token (required for image uploads)
BLOB_READ_WRITE_TOKEN=""

# (Optional) GitHub OAuth credentials for user login.
# Register the callback URL http://localhost:3000/api/auth/callback/github on
# your OAuth App. A GitHub OAuth App accepts only one callback URL, so use a
# separate App per environment (local, production).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""


# ==================================
# === DATABASE CONNECTION      ===
# ==================================
# Prisma reads DATABASE_URL directly. The value below matches the Docker
# Compose defaults in the variables that follow — if you change those, change
# this too. Format:
#   postgresql://<user>:<password>@<host>:<port>/<database>
# For Vercel/production, replace it with the connection string from your provider.

DATABASE_URL="postgresql://postgres:mysecretpassword@postgres:5432/postgres"

# ==================================
# === Seeding                    ===
# ==================================
# Base URL/path the seed uses for animal images. Read at seed time only and
# baked into the stored image paths. Local dev: "/uploads" (served from
# public/uploads). Hosted/demo: your blob store or CDN base URL. Defaults to
# "/uploads" when unset. Independent of NEXT_PUBLIC_IS_DEMO.
SEED_IMAGE_BASE_URL="/uploads"

# Local development only. When set, gives one seeded walk-in person this email
# address, so signing in with an OAuth account whose *verified* email matches
# will link that account to the existing person record instead of creating a
# new one. Used to exercise the account-to-person linking rule end to end.
# Leave unset in any shared or deployed environment — it seeds a real address.
# DEV_LINK_TEST_EMAIL=""

# ==================================
# === Reporting                  ===
# ==================================
# IANA timezone the shelter operates in. All report date-range boundaries are
# computed in this zone so every viewer sees identical numbers. Defaults to
# "America/New_York" when unset.
SHELTER_TIMEZONE="America/New_York"

# ==================================
# === Demo Setup                 ===
# ==================================
# Flag for demo, it will show the demo banner and different 
# implementation for uploading the animal images
NEXT_PUBLIC_IS_DEMO=false
# Secret to reset the data for the demo
CRON_SECRET=""
