{
  "name": "animal-shelter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=10.9.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "e2e": "playwright test",
    "test": "tsx --test \"app/**/*.test.ts\"",
    "test:db": "tsx scripts/test-db.ts",
    "test:all": "npm test && npm run test:db",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "typecheck": "next typegen && tsc --noEmit",
    "db": "prisma generate && prisma db push && prisma db seed",
    "//db:reset": "Prisma 7 removed migrate reset's auto-seed (and --skip-seed, nothing left to skip) — chain prisma db seed explicitly or this won't reseed.",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "postinstall": "npm run prisma:generate",
    "prisma:push": "dotenv -e .env.local -e .env.development -- prisma db push",
    "prisma:generate": "prisma generate",
    "prisma:studio": "dotenv -e .env.local -e .env.development -- prisma studio",
    "prisma:backfill-phone": "dotenv -e .env.local -e .env.development -e .env -- tsx prisma/backfill-phone-normalized.ts",
    "verify:ai": "dotenv -e .env.local -e .env.development -e .env -- tsx scripts/verify-ai-read-tools.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.44",
    "@ai-sdk/react": "^4.0.108",
    "@better-auth/core": "^1.7.5",
    "@better-auth/prisma-adapter": "^1.7.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tabler/icons-react": "^3.34.0",
    "@tanstack/react-table": "^9.1.2",
    "@uppy/core": "^6.0.1",
    "@uppy/dashboard": "^6.0.0",
    "@uppy/react": "^6.0.0",
    "@uppy/xhr-upload": "^6.0.0",
    "@vercel/blob": "^2.0.0",
    "ai": "^7.0.105",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "libphonenumber-js": "^1.13.11",
    "lucide-react": "^1.31.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.65.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.5",
    "use-debounce": "^10.0.4",
    "vaul": "^1.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^20.19.21",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^18.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
