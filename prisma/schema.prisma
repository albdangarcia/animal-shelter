// ═══════════════════════════════════════════════════
// CONFIG
// ═══════════════════════════════════════════════════

generator client {
  provider        = "prisma-client"
  output          = "./generated"
  // For `@@unique(..., where: ...)`: without it a partial index can only live
  // in a migration's raw SQL, and `db push` (which provisions the e2e and DB
  // test databases) would never create it.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════
// IDENTITY & ACCESS
// ═══════════════════════════════════════════════════

enum Role {
  ADMIN // Administrator with full system access
  STAFF // Shelter staff with operational privileges
  USER // Regular user, can browse animals and apply for adoption
  VOLUNTEER // Volunteer with limited access, can view animals and applications
}

model Person {
  id              String  @id @default(cuid())
  name            String
  email           String? @unique
  phone           String?
  phoneNormalized String?
  address         String?
  city            String?
  state           String?
  zipCode         String?

  // A Person MIGHT have a user account for logging in.
  user User?

  // Back-relations to all their interactions
  fosterProfile    FosterProfile?
  householdProfile HouseholdProfile?

  adoptionApplications       AdoptionApplication[]
  applicationStatusHistory   ApplicationStatusHistory[]
  fosterApplications         FosterApplication[]
  fosterApplicationHistory   FosterApplicationStatusHistory[]
  fosterPlacementsPlaced     FosterPlacement[]                @relation("FosterPlacementPlacedBy")
  fosterPlacementsReturned   FosterPlacement[]                @relation("FosterPlacementReturnedBy")
  favorites                  Favorite[]
  animalNotesAuthored        AnimalNote[]                     @relation("AnimalNoteAuthor")
  personNotesAuthored        PersonNote[]                     @relation("PersonNoteAuthor")
  partnerNotesAuthored       PartnerNote[]                    @relation("PartnerNoteAuthor")
  animalNotesEdited          AnimalNote[]                     @relation("AnimalNoteLastEditor")
  personNotesEdited          PersonNote[]                     @relation("PersonNoteLastEditor")
  partnerNotesEdited         PartnerNote[]                    @relation("PartnerNoteLastEditor")
  adoptionApplicationsEdited AdoptionApplication[]            @relation("AdoptionApplicationLastEditor")
  householdProfilesEdited    HouseholdProfile[]               @relation("HouseholdProfileLastEditor")
  noteEvents                 NoteEvent[]                      @relation("NoteEventActor")
  personNotes                PersonNote[]                     @relation("PersonNoteSubject") // notes written ABOUT this person
  partnerContacts            PartnerContact[]
  tasksAssigned              Task[]                           @relation("TasksAssignedTo")
  tasksCreated               Task[]                           @relation("TasksCreatedBy")
  reclaimedAnimalsAsOwner    Outcome[]                        @relation("ReclaimedByOwner")
  processedOutcomes          Outcome[]                        @relation("ProcessedOutcome")
  reversedOutcomes           Outcome[]                        @relation("ReversedOutcome")
  surrenderedAnimals         Intake[]                         @relation("SurrenderedBy")
  foundAnimals               Intake[]                         @relation("FoundBy")
  processedIntakes           Intake[]                         @relation("ProcessedBy")

  // financialTransactions  FinancialTransaction[]
  // processedTransactions  FinancialTransaction[] @relation("ProcessedFinance")
  // licenses               License[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  AnimalActivityLog AnimalActivityLog[]
  aiActionLogs      AiActionLog[]
  vitalsLogs        VitalsLog[]
  assessments       Assessment[]
  characteristicsAssigned AnimalCharacteristic[] @relation("CharacteristicAssignedBy")
  characteristicsRemoved  AnimalCharacteristic[] @relation("CharacteristicRemovedBy")
  medicalEntriesCreated      MedicalEntry[]      @relation("MedicalEntryCreatedBy")
  medicalEntriesAdministered MedicalEntry[]      @relation("MedicalEntryAdministeredBy")
  medicalEntriesVoided       MedicalEntry[]      @relation("MedicalEntryVoidedBy")
  medicalEntryEvents         MedicalEntryEvent[] @relation("MedicalEntryEventActor")
  euthanasiasAuthorized       EuthanasiaDetails[] @relation("EuthanasiaAuthorizedBy")
  euthanasiasPerformed        EuthanasiaDetails[] @relation("EuthanasiaPerformedBy")
  medicalConditionsCreated   MedicalCondition[]      @relation("MedicalConditionCreatedBy")
  medicalConditionsVoided    MedicalCondition[]      @relation("MedicalConditionVoidedBy")
  medicalConditionEvents     MedicalConditionEvent[] @relation("MedicalConditionEventActor")
  careEpisodesOpened         CareEpisode[]           @relation("CareEpisodeOpenedBy")
  careEpisodesClosed         CareEpisode[]           @relation("CareEpisodeClosedBy")
  careEpisodesVoided         CareEpisode[]           @relation("CareEpisodeVoidedBy")
  careEpisodeEvents          CareEpisodeEvent[]      @relation("CareEpisodeEventActor")
  medicationOrdersCreated      MedicationOrder[]      @relation("MedicationOrderCreatedBy")
  medicationOrdersDiscontinued MedicationOrder[]      @relation("MedicationOrderDiscontinuedBy")
  medicationOrdersVoided       MedicationOrder[]      @relation("MedicationOrderVoidedBy")
  medicationOrderEvents        MedicationOrderEvent[] @relation("MedicationOrderEventActor")
  medicationDosesCreated       MedicationDose[]       @relation("MedicationDoseCreatedBy")
  medicationDosesAdministered  MedicationDose[]       @relation("MedicationDoseAdministeredBy")
  medicationDosesVoided        MedicationDose[]       @relation("MedicationDoseVoidedBy")
  medicalDocumentsUploaded     MedicalDocument[]      @relation("MedicalDocumentUploadedBy")
  medicalDocumentsVoided       MedicalDocument[]      @relation("MedicalDocumentVoidedBy")
  medicalDocumentFilesRemoved  MedicalDocument[]      @relation("MedicalDocumentFileRemovedBy")
  medicalDocumentEvents        MedicalDocumentEvent[] @relation("MedicalDocumentEventActor")
  vetVisitReportsReported      VetVisitReport[]       @relation("VetVisitReportReportedBy")
  vetVisitReportsReviewed      VetVisitReport[]       @relation("VetVisitReportReviewedBy")

  @@index([phoneNormalized])
  @@map("persons")
}

model User {
  id            String  @id @default(cuid())
  /// Denormalized copy of Person.name — Better Auth requires `name` on the
  /// user table, but the name of record lives on Person. NEVER write this
  /// directly — `syncPersonToUser` in app/lib/services/user-person-sync.ts is
  /// the only writer, and every action that edits a Person's contact details
  /// goes through it.
  name          String
  /// Denormalized copy of Person.email, and the address Better Auth matches a
  /// returning sign-in against. Same single writer as `name`: correcting the
  /// person's email has to move this too, or they keep signing in under the
  /// address the shelter no longer has for them. That writer also clears
  /// `emailVerified` whenever it moves this column — see the note there.
  email         String  @unique
  emailVerified Boolean @default(false) @map(name: "email_verified")
  image         String?
  role          Role    @default(USER)

  // The one-to-one link to the master Person record
  personId String @unique
  // Restrict to prevent accidental deletion of a Person with history
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  sessions Session[]
  accounts Account[]

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  /// Null is an active account; any timestamp is one that is barred. The whole
  /// of the state, which is what makes deactivation reversible with no schema
  /// change. It exists because the app has no other way to stop an account:
  /// GitHub sign-up is open to anyone, and demoting to USER leaves the five
  /// `MY_*` permissions, so an abusive applicant keeps submitting. It also
  /// honors a "close my account" request without destroying shelter history.
  ///
  /// Set only by the deactivation service, which revokes the account's sessions
  /// in the same transaction. Three points enforce it: `session.create.before`
  /// refuses a new session, that revocation ends the open ones, and
  /// `getCachedSession` refuses any that slipped between the two.
  ///
  /// Never implement "deactivated" by unlinking the Person instead — an
  /// unlinked account still signs in, and the record it leaves behind stops
  /// being hidden by `nonAdminPersonFilter`.
  deactivatedAt DateTime? @map(name: "deactivated_at")

  @@map(name: "users")
}

/// Better Auth session row — first time this app has session rows; the prior
/// strategy was JWT-only.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map(name: "expires_at")
  ipAddress String?  @map(name: "ip_address")
  userAgent String?  @map(name: "user_agent")

  userId String @map(name: "user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@index([userId])
  @@map(name: "sessions")
}

/// Better Auth's shape, not Auth.js's — no composite PK, has `password` for
/// credential accounts. Identity is `(providerId, accountId)`, e.g.
/// `providerId: "credential"`. Better Auth briefly (1.7.0-1.7.2) identified
/// accounts by a separate `issuer` field instead; that design was reverted
/// upstream in 1.7.3, and this schema was migrated back to match.
model Account {
  id         String @id @default(cuid())
  accountId  String @map(name: "account_id")
  providerId String @map(name: "provider_id")

  userId String @map(name: "user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?   @map(name: "access_token")
  refreshToken          String?   @map(name: "refresh_token")
  idToken               String?   @map(name: "id_token")
  accessTokenExpiresAt  DateTime? @map(name: "access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map(name: "refresh_token_expires_at")
  scope                 String?
  // Credential sign-in only. Never set for OAuth accounts.
  password              String?

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map(name: "accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map(name: "expires_at")

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@index([identifier])
  @@map(name: "verifications")
}

// ═══════════════════════════════════════════════════
// PEOPLE-ADJACENT PROFILES
// ═══════════════════════════════════════════════════

enum LivingSituation {
  OWN_HOME
  RENT_APARTMENT
  RENT_HOUSE
  LIVE_WITH_FAMILY
  OTHER
}

enum FosterStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

/// The roster record for an approved foster parent: their capabilities and current
/// standing. Distinct from `FosterApplication` (the reviewable request to become one)
/// and `FosterPlacement` (a dated event of an animal actually staying with them).
model FosterProfile {
  id            String       @id @default(cuid())
  status        FosterStatus @default(ACTIVE)
  internalNotes String?

  maxAnimals         Int      @default(1) @map(name: "max_animals")
  hasQuarantineSpace Boolean? @map(name: "has_quarantine_space")
  canGiveOralMeds    Boolean? @map(name: "can_give_oral_meds")
  canBottleFeed      Boolean? @map(name: "can_bottle_feed")
  canTransport       Boolean? @map(name: "can_transport")
  acceptsMedical     Boolean? @map(name: "accepts_medical")
  acceptsHospice     Boolean? @map(name: "accepts_hospice")
  availabilityNotes  String?  @map(name: "availability_notes")

  speciesCapabilities Species[] @relation("FosterProfileSpeciesCapability")

  approvedAt DateTime? @map(name: "approved_at")

  personId String @unique @map(name: "person_id")
  // Restrict: a foster's placements are care history.
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  placements FosterPlacement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("foster_profiles")
}

model HouseholdProfile {
  id       String @id @default(cuid())
  personId String @unique @map(name: "person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  livingSituation         LivingSituation @map(name: "living_situation")
  hasYard                 Boolean?        @map(name: "has_yard")
  landlordPermission      Boolean?        @map(name: "landlord_permission")
  householdSize           Int             @map(name: "household_size")
  hasChildren             Boolean?        @map(name: "has_children")
  childrenAges            Int[]           @map(name: "children_ages")
  otherAnimalsDescription String?         @map(name: "other_animals_description")
  animalExperience        String?         @map(name: "animal_experience")

  // Who last wrote this profile, whoever that was — the owner from their own
  // account page or an application they submitted, or staff on their behalf.
  // Null only for a row that predates the columns. `updatedAt` cannot say this:
  // it moves for every write and names no one.
  lastEditedById String?   @map(name: "last_edited_by_id")
  lastEditedBy   Person?   @relation("HouseholdProfileLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  lastEditedAt   DateTime? @map(name: "last_edited_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("household_profiles")
}

// ═══════════════════════════════════════════════════
// PARTNERS
// ═══════════════════════════════════════════════════

enum PartnerType {
  SHELTER
  RESCUE_GROUP
  VET_CLINIC
  GOVERNMENT_AGENCY // e.g., Animal Control
}

model Partner {
  id   String      @id @default(cuid())
  name String      @unique
  type PartnerType

  // Contact Info (the organization's own — for named people, see contacts below)
  email   String?
  phone   String?
  website String?
  address String?
  city    String?
  state   String?
  zipCode String?

  // Retire a partner without deleting it
  isActive Boolean @default(true)

  // Quick pinned blurb (e.g. "transfers weekdays only"). Dated history lives in partnerNotes.
  notes String?

  // Back-relations
  contacts     PartnerContact[]
  partnerNotes PartnerNote[]

  transferredInAnimals  Intake[]
  transferredOutAnimals Outcome[]
  medicalEntries        MedicalEntry[]
  careEpisodes          CareEpisode[]
  vetVisitReports       VetVisitReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partners")
}

// A Person can be a contact at many Partners, and a Partner can have many contacts
model PartnerContact {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  personId  String
  person    Person  @relation(fields: [personId], references: [id])

  role      String? // e.g., "Intake Coordinator", "Director", "After-hours line"
  isPrimary Boolean @default(false)
  isActive  Boolean @default(true) // false = no longer the contact, kept for history

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerId, personId])
  // At most one primary contact per partner. Declared here so that `db push`
  // creates it too; a `findUnique` by `partnerId` alone compiles but does not
  // find the primary.
  @@unique([partnerId], map: "partner_contact_one_primary", where: { isPrimary: true })
  @@map("partner_contacts")
}

// A fixed id and database constraint keep organization settings to one row.
// A missing row is valid during initial setup; readers use environment defaults.
model ShelterSettings {
  id                  String   @id @default("shelter")
  timezone            String
  weightUnitSystem    String
  defaultPhoneCountry String
  // Country used for the derived Person.phoneNormalized index.
  phoneIndexCountry   String?
  /// When each medication dose slot's window ends, as "HH:mm" on the
  /// shelter's clock. A slot with no dose recorded by then reads as missed.
  /// AM before Midday before PM; a window never crosses midnight.
  amDoseEndTime       String   @default("10:00")
  middayDoseEndTime   String   @default("14:00")
  pmDoseEndTime       String   @default("20:00")
  updatedAt           DateTime @updatedAt

  @@map("shelter_settings")
}

// ═══════════════════════════════════════════════════
// LOCATION MANAGEMENT
// ═══════════════════════════════════════════════════

enum LocationType {
  KENNEL
  ISOLATION
  MEDICAL
  QUARANTINE
  OFFSITE
  OTHER
}

model Location {
  id   String       @id @default(cuid())
  name String       @unique
  type LocationType

  units Unit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map(name: "deleted_at")

  @@map("locations")
}

model Unit {
  id         String   @id @default(cuid())
  locationId String   @map(name: "location_id")
  location   Location @relation(fields: [locationId], references: [id])
  name       String
  capacity   Int      @default(1)

  animals Animal[]

  // Informational only — a placement's `previousUnitId`, set null if the unit is deleted.
  fosterPlacementsAsPrevious FosterPlacement[]

  // Informational only — an outcome's `previousUnitId`, set null if the unit is deleted.
  outcomesAsPrevious Outcome[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map(name: "deleted_at")

  @@unique([name, locationId])
  @@index([locationId])
  @@map("units")
}

// ═══════════════════════════════════════════════════
// ANIMAL CORE
// ═══════════════════════════════════════════════════

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

enum AnimalSize {
  SMALL
  MEDIUM
  LARGE
  XLARGE
}

enum AnimalListingStatus {
  DRAFT // Profile is being prepared, not yet ready for public view.
  PUBLISHED // Profile is live, publicly accessible, and available for applications.

  PENDING_ADOPTION // An application has been approved; animal is temporarily reserved. Not accepting new applications.

  // for the outcome process
  ARCHIVED // Profile is no longer public (e.g., animal adopted, transferred, or otherwise unavailable) and is kept for records.
}

enum CharacteristicCategory {
  BEHAVIOR // For behavioral notes like "Bite History", "On-Leash Reactivity"
  MEDICAL // For health-related tags like "Deaf", "Heartworm Positive"
  ENVIRONMENT // For home-related needs like "Good With Kids", "Housebroken"
  ADMINISTRATIVE // For internal, process-related tags like "Adoption Fee Waived"
  OTHER // For any other tags that don't fit the above categories
}

model Animal {
  id                 String              @id @default(cuid())
  name               String
  birthDate          String            @map(name: "birth_date")
  sex                Sex
  /// Expected ADULT size, set by staff. Never derived from current weight — a puppy's
  /// current weight does not predict its adult size. Nullable: "unknown" is the honest
  /// answer for an indeterminate mixed-breed stray. Note that a null size matches no
  /// public size facet, so the animal will not appear in size-filtered search results.
  size               AnimalSize?
  /// Last known weight, CACHED from the most recent non-deleted VitalsLog entry with a
  /// non-null weight. NEVER write this directly — only the vitals service's
  /// recomputeCurrentWeight (and animal intake, for the seed entry) may set it.
  currentWeightGrams Int?                @map(name: "current_weight_grams")
  heightCm           Float?              @map(name: "height_cm")
  description        String?
  listingStatus      AnimalListingStatus @default(DRAFT)
  archiveReason      OutcomeType? /// Should only be set when listingStatus is ARCHIVED. Explains why the animal is no longer available.

  // Relations
  // mandatory relationship to Species
  speciesId            String                @map("species_id")
  species              Species               @relation(fields: [speciesId], references: [id])
  breeds               Breed[]
  colors               Color[] // all colors, including the primary
  primaryColorId       String                @map("primary_color_id")
  primaryColor         Color                 @relation("PrimaryColor", fields: [primaryColorId], references: [id])
  // Explicit join with provenance (who assigned the trait, when, and — from
  // which assessment it was sourced from). Replaces the former
  // implicit `Characteristic[]` many-to-many, which claimed traits on a public
  // profile with no record of who claimed them.
  animalCharacteristics AnimalCharacteristic[]
  animalImages         AnimalImage[]
  vitalsLogs           VitalsLog[]
  medicalEntries       MedicalEntry[]
  medicalConditions    MedicalCondition[]
  careEpisodes         CareEpisode[]
  medicationOrders     MedicationOrder[]
  medicationDoses      MedicationDose[]
  medicalDocuments     MedicalDocument[]
  vetVisitReports      VetVisitReport[]
  notes                AnimalNote[]
  tasks                Task[]
  favorites            Favorite[]
  adoptionApplications AdoptionApplication[]
  intake               Intake[]
  Outcome              Outcome[]
  activityLog          AnimalActivityLog[]

  // Dated foster placement events. "Currently in foster" is derived — an open
  // placement (endDate == null) exists — never stored as a flag on the animal.
  fosterPlacements FosterPlacement[]

  // The kennel the animal is currently housed in. Null for fostered or not-yet-placed animals.
  currentUnitId String? @map(name: "current_unit_id")
  currentUnit   Unit?   @relation(fields: [currentUnitId], references: [id], onDelete: SetNull)

  assessments        Assessment[]

  createdAt   DateTime  @default(now()) @map(name: "created_at")
  updatedAt   DateTime  @updatedAt @map(name: "updated_at")
  publishedAt DateTime? @map(name: "published_at")

  @@index([currentUnitId])
  @@map(name: "animals")
}

model Species {
  id      String   @id @default(cuid())
  name    String   @unique
  animals Animal[]
  breeds  Breed[] // A species can have many breeds

  fosterProfiles     FosterProfile[]     @relation("FosterProfileSpeciesCapability")
  fosterApplications FosterApplication[] @relation("FosterApplicationSpeciesCapability")
  medicalItems       MedicalItem[]       @relation("MedicalItemSpecies")
  medicalProtocols   MedicalProtocol[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map(name: "deleted_at")

  @@map(name: "species")
}

model Breed {
  id        String   @id @default(cuid())
  name      String
  animals   Animal[]
  speciesId String   @map(name: "species_id")
  species   Species  @relation(fields: [speciesId], references: [id])

  /// Typical expected adult size for this breed. Reference data only — used to
  /// prefill the size select on the animal intake form. The authoritative value
  /// for an individual animal is Animal.size, which staff can override.
  typicalSize AnimalSize? @map(name: "typical_size")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map(name: "deleted_at")

  @@unique([name, speciesId])
  @@map(name: "breeds")
}

model Color {
  id                String   @id @default(cuid())
  name              String   @unique // "Black", "White", "Brown", "Brindle", "Tabby"
  animals           Animal[] // animals that have this color (in their full color set)
  primaryForAnimals Animal[] @relation("PrimaryColor") // animals where this is the primary color

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map(name: "deleted_at")

  @@map(name: "colors")
}

model Characteristic {
  id       String                 @id @default(cuid())
  name     String                 @unique // Globally unique; a trait is identified by name alone, regardless of category
  category CharacteristicCategory // The group this tag belongs to (BEHAVIOR, MEDICAL, etc.)

  // Every assignment of this trait to an animal, active or soft-removed.
  animalCharacteristics AnimalCharacteristic[]

  // Template fields whose findings propose this trait for staff confirmation.
  proposedByFields AssessmentTemplateField[] @relation("CharacteristicProposedByFields")

  // Problem-list conditions that stand for this trait.
  medicalConditions MedicalCondition[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map(name: "deleted_at")

  @@map("characteristics")
}

/// Explicit animal ↔ characteristic join carrying provenance. Every
/// assignment records who made it and when; an assessment-sourced assignment
/// additionally links the observation via `sourceAssessmentId`, and one added
/// from a problem-list condition links the condition via `sourceConditionId`.
///
/// Soft-removed via `removedAt` rather than deleted, so "removed by X on date Y"
/// survives. The unique key is `(animalId, characteristicId)` — one row per pair
/// for the life of the animal — and re-adding a removed trait clears `removedAt`
/// on that same row (a new `assignedBy`/`assignedAt`, source reset to null).
model AnimalCharacteristic {
  id String @id @default(cuid())

  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  characteristicId String
  characteristic   Characteristic @relation(fields: [characteristicId], references: [id], onDelete: Cascade)

  assignedById String
  assignedBy   Person   @relation("CharacteristicAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now()) @map(name: "assigned_at")

  /// Set when this assignment was confirmed from an assessment finding;
  /// null for a manual assignment. SetNull, not Cascade — losing the source
  /// assessment must not silently drop a trait staff have vouched for.
  sourceAssessmentId String?
  sourceAssessment   Assessment? @relation(fields: [sourceAssessmentId], references: [id], onDelete: SetNull)

  /// Set when this assignment was added from a problem-list condition that
  /// stands for the trait; null otherwise. At most one of the two sources is
  /// set. SetNull, as for an assessment.
  sourceConditionId String?
  sourceCondition   MedicalCondition? @relation(fields: [sourceConditionId], references: [id], onDelete: SetNull)

  /// Free-text note on the assignment. Predates the findings-sourcing work
  /// (added for general use); nothing currently writes to it.
  note String?

  /// Soft removal. A non-null `removedAt` marks an inactive assignment kept for
  /// its history; the default characteristics view filters these out.
  removedAt   DateTime? @map(name: "removed_at")
  removedById String?
  removedBy   Person?   @relation("CharacteristicRemovedBy", fields: [removedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([animalId, characteristicId])
  @@index([characteristicId])
  @@index([sourceAssessmentId])
  @@index([sourceConditionId])
  @@map("animal_characteristics")
}

model AnimalImage {
  id  String @id @default(cuid())
  url String

  /// Gallery position within an animal's photos, ascending. "Primary" is the
  /// lowest sortOrder — there is no isPrimary flag. Not unique per animal:
  /// concurrent uploads can transiently collide, and reads break the tie on
  /// createdAt (see app/lib/utils/animal-image-order.ts).
  sortOrder Int @default(0) @map(name: "sort_order")

  animalId String @map(name: "animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId, sortOrder])
  @@map(name: "animal_images")
}

// ═══════════════════════════════════════════════════
// INTAKE & OUTCOME
// ═══════════════════════════════════════════════════

enum IntakeType {
  OWNER_SURRENDER // OS / Return
  STRAY
  BORN_IN_CARE
  TRANSFER_IN
  SEIZE // e.g., from a legal case
  SERVICE_IN // e.g., temporary boarding for a community member
  ACO_IMPOUND // Animal Control impound
}

enum OutcomeType {
  ADOPTION
  TRANSFER_OUT
  RETURN_TO_OWNER
  DECEASED
  EUTHANIZED
  OTHER
}

model Intake {
  id String @id @default(cuid())

  // The calendar day the animal arrived, as `yyyy-MM-dd`. Not an instant, and
  // no default: every writer states the day. See docs/calendar-days.md.
  intakeDate String

  type IntakeType

  animalId String

  // The animal created as a result of this intake event. A one-to-one relationship.
  animal Animal @relation(fields: [animalId], references: [id])

  // Optional fields depending on the intake type

  // For OWNER_SURRENDER or RETURN
  surrenderingPersonId String?
  surrenderingPerson   Person? @relation(name: "SurrenderedBy", fields: [surrenderingPersonId], references: [id])

  // For STRAY
  dateLost        String?
  foundAddress    String?
  foundCity       String?
  foundState      String?
  foundZipCode    String?
  foundByPersonId String?
  foundByPerson   Person?   @relation(name: "FoundBy", fields: [foundByPersonId], references: [id])

  // For TRANSFER_IN
  sourcePartnerId String?
  sourcePartner   Partner? @relation(fields: [sourcePartnerId], references: [id])

  // General fields
  staffMemberId String
  staffMember   Person  @relation(name: "ProcessedBy", fields: [staffMemberId], references: [id])
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId])
  @@index([sourcePartnerId])
  @@index([staffMemberId])
  @@map("intakes")
}

model Outcome {
  id String @id @default(cuid())

  // The calendar day the animal left, as `yyyy-MM-dd`. Not an instant, and no
  // default: every writer states the day. See docs/calendar-days.md.
  outcomeDate String

  type OutcomeType

  animalId String
  // The animal leaving the shelter. A one-to-one relationship.
  animal   Animal @relation(fields: [animalId], references: [id])

  // Optional fields depending on the outcome type

  // For ADOPTION. A reversed outcome keeps its link, since the link is part of
  // what was recorded, so one application can be linked from several adoption
  // outcomes over time: at most one that is not reversed (the unique index
  // below).
  adoptionApplicationId String?
  adoptionApplication   AdoptionApplication? @relation(fields: [adoptionApplicationId], references: [id])

  // Set when this outcome was created via a FOSTER_TO_ADOPT placement conversion.
  fosterPlacement FosterPlacement?

  /// The clinical record owned by this outcome, retained after reversal.
  medicalEntry MedicalEntry?

  // For RETURN_TO_OWNER
  ownerId String?
  owner   Person? @relation("ReclaimedByOwner", fields: [ownerId], references: [id])

  // For TRANSFER_OUT
  destinationPartnerId String?
  destinationPartner   Partner? @relation(fields: [destinationPartnerId], references: [id])

  // General fields
  staffMemberId String
  staffMember   Person  @relation(name: "ProcessedOutcome", fields: [staffMemberId], references: [id])
  notes         String?

  // The animal's listingStatus just before this outcome archived it, restored
  // if the outcome is reversed. Listing status is not derivable from intakes
  // and outcomes (it also carries DRAFT and publication), so this records a
  // fact rather than caching one. Null on outcomes recorded before it was
  // kept.
  previousListingStatus AnimalListingStatus?

  // The unit the animal was housed in just before this outcome took it out,
  // put back if the outcome is reversed. Informational only: the unit is not
  // reserved while the animal is away. Null when the animal was unhoused or in
  // foster, on outcomes recorded before it was kept, and if the unit is
  // hard-deleted.
  previousUnitId String?
  previousUnit   Unit?   @relation(fields: [previousUnitId], references: [id], onDelete: SetNull)

  // A reversal voids an outcome that should never have been recorded: a
  // reversed outcome is kept, but counts for nothing. Write-once: nothing
  // clears `reversedAt`, so a reversal made in error is answered by recording
  // the outcome again, and the record still shows this one was voided, when
  // and by whom. The reason is required whenever `reversedAt` is set.
  reversedAt     DateTime?
  reversedById   String?
  reversedBy     Person?   @relation(name: "ReversedOutcome", fields: [reversedById], references: [id])
  reversalReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // At most one live adoption outcome per application. Prisma still offers a
  // partial index to `findUnique`, but a lookup by `adoptionApplicationId`
  // ignores its `where` and can return a reversed outcome: use `findFirst`
  // with `reversedAt: null`.
  @@unique([adoptionApplicationId], where: { reversedAt: null })
  @@index([animalId])
  @@map("outcomes")
}

// ═══════════════════════════════════════════════════
// MEDICAL
// ═══════════════════════════════════════════════════

/// A dated set of measurements taken on one occasion. Append-mostly: corrections are
/// edits by staff, removals are soft deletes. Weight is stored in INTEGER GRAMS —
/// see the units note on Animal.currentWeightGrams.
model VitalsLog {
  id String @id @default(cuid())

  /// When the measurement was TAKEN (backdatable — fosters report late).
  /// Distinct from createdAt, which is when the row was written.
  /// An instant, not a calendar day: a measurement is taken at a time, so unlike
  /// Intake.intakeDate (a day, no time of day) it is a DateTime. See
  /// docs/calendar-days.md.
  recordedAt DateTime @default(now()) @map(name: "recorded_at")

  /// At least one of the three measurement fields must be present. `notes` does NOT
  /// count — a notes-only entry is an AnimalNote. Enforced in the Zod schema.
  weightGrams        Int?   @map(name: "weight_grams")
  temperatureC       Float? @map(name: "temperature_c")
  /// Body condition score, 1-9 (5 = ideal). The standard shelter/vet ordinal measure.
  bodyConditionScore Int?   @map(name: "body_condition_score")

  notes String?

  animalId String @map(name: "animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  recordedById String @map(name: "recorded_by_id")
  recordedBy   Person @relation(fields: [recordedById], references: [id])

  /// The exam these were measured during, when they were recorded with one.
  exam ExamDetails?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map(name: "deleted_at")

  @@index([animalId, recordedAt])
  @@map("vitals_logs")
}

/// What a catalog item is. A vaccine, test or treatment entry's kind must
/// match its item's kind. A medication is never an entry's item: it is what a
/// medication order names.
enum MedicalItemKind {
  VACCINE
  TEST
  TREATMENT
  MEDICATION
}

/// What a medical entry records. Each kind has its own one-to-one details
/// table, written once the care is given.
///
/// Vaccines, tests and treatments are given from the catalog, so each entry
/// points at a catalog item. Surgeries, microchips and exams have no catalog
/// item: a surgery says which procedure it is, a microchip carries its
/// number, and an exam names its type. Euthanasia and death are owned by
/// their outcomes and have no catalog item.
/// New values go at the end (see `MedicalEntryStatus`).
enum MedicalEntryKind {
  VACCINE
  TEST
  TREATMENT
  SURGERY
  MICROCHIP
  EXAM
  EUTHANASIA
  DEATH
}

/// The recorded reason for euthanasia; Other requires explanatory notes.
enum EuthanasiaReasonCategory {
  MEDICAL
  BEHAVIORAL
  OTHER
}

/// How a death occurred; an unknown cause is stored separately as null.
enum DeathCircumstances {
  FOUND_DEAD
  DURING_PROCEDURE
  OTHER
}

/// Which surgery an entry is. Defined here rather than in the catalog,
/// because whether an animal is spayed or neutered is worked out from it.
enum SurgeryProcedure {
  SPAY
  NEUTER
  DENTAL
  AMPUTATION
  ENUCLEATION
  MASS_REMOVAL
  OTHER
}

/// What shows that a surgery was done before the animal arrived, when nobody
/// at the shelter saw it done.
enum SurgeryEvidence {
  OWNER_RECORDS
  VET_RECORDS
  TATTOO
  SCAR
  FOUND_ON_EXAM
}

/// Why an animal is exempt from being spayed or neutered, for now or for
/// good. Stored on a declined spay or neuter entry.
enum SpayNeuterExemptionReason {
  TOO_YOUNG_OR_UNDERWEIGHT
  MEDICAL_RISK
  PARTNER_WILL_ALTER
  OTHER
}

/// Which exam an entry is. On the entry at every status, so scheduled care
/// can say it is the intake exam before anything is recorded.
enum ExamType {
  /// The exam on arrival. It counts for the stay it is dated in.
  INTAKE
  VET
  RECHECK
  PRE_ADOPTION
}

/// What an exam concluded, as a whole.
enum ExamResult {
  NO_CONCERNS
  /// Something to treat, recorded as care in its own right.
  NEEDS_TREATMENT
  /// A vet should look at the animal before anything else is decided.
  NEEDS_VET_REVIEW
}

/// How one body system looked on an exam.
enum ExamFindingStatus {
  NORMAL
  /// Something was found. The finding's note says what.
  ABNORMAL
  NOT_EXAMINED
}

/// Whether an exam found the animal intact or already spayed or neutered.
/// Only a surgery entry makes an animal altered on its record: an exam that
/// finds an animal altered records the surgery it found.
enum ReproductiveStatus {
  INTACT
  ALTERED
  UNDETERMINED
}

/// Where an entry stands. Every writer states it; there is no default.
///
/// The only moves are: scheduled, then recorded as given (COMPLETED),
/// declined, or rescheduled to another due day. Care given without being
/// scheduled first is written as COMPLETED directly. COMPLETED and DECLINED
/// are final: a declined entry made in error is voided and scheduled again.
/// Any entry not yet voided can be voided, whatever its status.
///
/// The values are listed in the order they were added, which is the order a
/// migrated database holds them in (a new enum value goes at the end). Keep
/// it that way, so a database built from this file sorts the same.
enum MedicalEntryStatus {
  /// Given (or, for a test, run).
  COMPLETED
  /// Planned for its due day and not given yet. It is the to-do: nothing is
  /// copied into Tasks.
  SCHEDULED
  /// Scheduled, then not given on purpose, for the reason stored with it.
  DECLINED
}

/// Who gave the care: the shelter itself, an outside vet while the animal was
/// in the shelter's care, or anyone before the animal arrived.
enum MedicalEntrySource {
  IN_HOUSE
  OUTSIDE_VET
  BEFORE_INTAKE
}

enum MedicalEntryEventAction {
  CREATED
  EDITED
  VOIDED
  COMPLETED // A scheduled entry was recorded as given
  RESCHEDULED // A scheduled entry's due day moved
  DECLINED // A scheduled entry was declined
}

enum TestResult {
  POSITIVE
  NEGATIVE
  INCONCLUSIVE
  INVALID
}

enum MedicalRoute {
  ORAL
  SUBCUTANEOUS
  INTRAMUSCULAR
  INTRANASAL
  TOPICAL
  OPHTHALMIC
  OTIC
  INTRAVENOUS
  TRANSDERMAL
}

enum DoseUnit {
  MG
  ML
  TABLET
  CAPSULE
  DROP
  APPLICATION
  UNIT
}

/// A vaccine, test, treatment or medication the shelter uses, managed by
/// admins. Retiring an item (`retiredAt`) hides it from the pickers for new
/// entries and orders; entries and orders that already use it keep it and
/// keep showing it, and retiring can be undone. Items are never deleted while
/// an entry or an order points at them.
///
/// The defaults (manufacturer, route, dose) are copied onto an entry's details
/// when it is recorded, so changing a default never rewrites history. The name
/// is not copied: a rename (a typo fix) shows on old entries.
model MedicalItem {
  id           String          @id @default(cuid())
  kind         MedicalItemKind
  name         String
  manufacturer String?

  /// The species this item applies to. Empty means every species.
  species Species[] @relation("MedicalItemSpecies")

  /// Defaults for treatments and medications (route, dose and unit) and
  /// vaccines (route only).
  defaultRoute      MedicalRoute? @map(name: "default_route")
  defaultDoseAmount Float?        @map(name: "default_dose_amount")
  defaultDoseUnit   DoseUnit?     @map(name: "default_dose_unit")

  /// The booster or repeat interval. Recording an entry for this item offers
  /// to schedule the next one this many days after the day it was given. A
  /// medication has none: its order says how often.
  repeatIntervalDays Int? @map(name: "repeat_interval_days")

  /// Rabies vaccines carry a tag number, a duration and a valid-until day.
  /// Only vaccines can be rabies vaccines.
  isRabies Boolean @default(false) @map(name: "is_rabies")

  /// What a test reports, one result per analyte. Only tests have analytes.
  analytes         MedicalItemAnalyte[]
  entries          MedicalEntry[]
  protocolSteps    MedicalProtocolStep[]
  medicationOrders MedicationOrder[]

  retiredAt DateTime? @map(name: "retired_at")
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")

  @@unique([kind, name])
  @@map("medical_items")
}

/// One thing a test reports, such as "FeLV antigen" on a combination snap
/// test. A row, not a string on the item, so a result can point at it.
/// Retiring an analyte stops new results asking for it; old results keep it.
model MedicalItemAnalyte {
  id        String      @id @default(cuid())
  itemId    String      @map(name: "item_id")
  item      MedicalItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int         @map(name: "sort_order")

  results TestAnalyteResult[]

  retiredAt DateTime? @map(name: "retired_at")
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")

  @@unique([itemId, name])
  @@map("medical_item_analytes")
}

/// One vaccine, test, treatment, surgery, microchip or exam for an animal:
/// scheduled, given, or declined. The lifecycle every kind shares lives here;
/// what is particular to a kind lives in its details row. Neither `kind` nor
/// `animalId` changes after the entry is written: a wrong one is voided and
/// recorded again. Every change is written to `events`, with before and after
/// values.
///
/// What each kind holds, whatever its status (the entry service enforces this
/// and the status rules below, since a check constraint can't be declared
/// here):
/// - VACCINE, TEST, TREATMENT: `itemId`, an item of the same kind; no
///   `procedure`, `chipNumber` or `examType`.
/// - SURGERY: `procedure`; no `itemId`, `chipNumber` or `examType`.
/// - MICROCHIP: `chipNumber` once completed, null before; no `itemId`,
///   `procedure` or `examType`.
/// - EXAM: `examType`; no `itemId`, `procedure` or `chipNumber`. Completed,
///   its details row holds a finding for each body system it was examined
///   against. An exam is given in house or by an outside vet, never before
///   intake, so its day is always known.
///
/// What each status holds:
/// - SCHEDULED: `dueDate`; no `completedDate`, `source`, `declineReason`,
///   `exemptionReason`, `reviewDate`, `administeredById` or details row.
/// - COMPLETED: `source` and a details row; `completedDate` as below;
///   `dueDate` kept when it was scheduled first, null when recorded directly.
/// - DECLINED: `dueDate` kept when it was scheduled first; no
///   `completedDate`, `source`, `administeredById` or details row. A declined
///   spay or neuter is an exemption, with `exemptionReason` and maybe a
///   `reviewDate`. Any other declined entry has a `declineReason`.
///
/// A details row exists only for care that happened: lot numbers, results,
/// a surgery's findings and an exam's findings are written when the care is
/// recorded as given.
model MedicalEntry {
  id       String           @id @default(cuid())
  animalId String           @map(name: "animal_id")
  animal   Animal           @relation(fields: [animalId], references: [id], onDelete: Cascade)
  kind     MedicalEntryKind

  /// A single immutable link across both outcome-owned kinds, including voided rows.
  outcomeId String?  @unique @map(name: "outcome_id")
  outcome   Outcome? @relation(fields: [outcomeId], references: [id], onDelete: Restrict)

  /// The catalog item, for a vaccine, test or treatment. Null for a surgery,
  /// a microchip, an exam, euthanasia or death, which have no catalog item.
  itemId String?      @map(name: "item_id")
  item   MedicalItem? @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// Which surgery, on a SURGERY entry at every status: scheduled surgery and
  /// an exemption have no details row, but still say which procedure they
  /// are. Null for every other kind.
  procedure SurgeryProcedure?

  /// The microchip's number, on a completed MICROCHIP entry, and null
  /// otherwise. Stored normalised: no spaces or hyphens, upper case. No two
  /// entries that aren't voided hold the same number, so a voided entry's
  /// number can be used again.
  chipNumber String? @map(name: "chip_number")

  /// Which exam, on an EXAM entry at every status: a scheduled exam has no
  /// details row, but still says whether it is the intake exam. Null for
  /// every other kind.
  examType ExamType? @map(name: "exam_type")

  status MedicalEntryStatus

  /// The calendar day the care is due, as `yyyy-MM-dd`. Set when it is
  /// scheduled and moved by a reschedule; kept once it is given or declined,
  /// so the record still shows when it was due. Whether it is overdue is
  /// worked out when someone looks, against the shelter's today.
  dueDate String? @map(name: "due_date")

  /// The calendar day the care was given, as `yyyy-MM-dd`. Null while
  /// scheduled or declined. On a COMPLETED entry, null only when the source
  /// is BEFORE_INTAKE and nobody knows the day: the care happened, but its day
  /// is not on record. The service and the form schema enforce this. See
  /// docs/calendar-days.md.
  completedDate String? @map(name: "completed_date")

  /// Where care was given. Required on completed care except DEATH, which
  /// records an event rather than administered care. Null before completion.
  source MedicalEntrySource?

  /// Why the care won't be given, in words. On a DECLINED entry: required,
  /// except on a spay/neuter exemption, where it is required only when the
  /// exemption's reason is OTHER. Null on every other status.
  declineReason String? @map(name: "decline_reason")

  /// Set only on a declined spay or neuter, and required there: the entry is
  /// then an exemption, and the animal counts as exempt while it holds.
  exemptionReason SpayNeuterExemptionReason? @map(name: "exemption_reason")

  /// The calendar day an exemption is looked at again, as `yyyy-MM-dd`.
  /// Optional, and set only beside `exemptionReason`. The exemption holds
  /// through this day and lapses the day after; with no review day, it holds
  /// until it is voided.
  reviewDate String? @map(name: "review_date")

  /// The vet clinic that gave the care, or a vet's name when the clinic is
  /// not a partner. Never set for IN_HOUSE care.
  vetPartnerId String?  @map(name: "vet_partner_id")
  vetPartner   Partner? @relation(fields: [vetPartnerId], references: [id])
  vetName      String?  @map(name: "vet_name")

  administeredById String? @map(name: "administered_by_id")
  administeredBy   Person? @relation("MedicalEntryAdministeredBy", fields: [administeredById], references: [id])

  notes String?

  /// Shared by the entries one batch wrote together: the same care given to,
  /// or scheduled for, several animals at once. Provenance only: each entry
  /// stands on its own and is changed, voided or recorded one at a time. Null
  /// for an entry written by itself.
  batchId String? @map(name: "batch_id")

  /// The protocol step that scheduled this entry when the animal arrived.
  /// Provenance only, as `batchId` is: the entry stands on its own and is
  /// recorded, rescheduled, declined or voided like any other. A saved step's
  /// care never changes, so this always points at what was applied. Null for
  /// care scheduled by hand.
  protocolStepId String?              @map(name: "protocol_step_id")
  protocolStep   MedicalProtocolStep? @relation(fields: [protocolStepId], references: [id], onDelete: Restrict)

  /// True when a foster wrote the entry (a treatment given in foster), or
  /// staff recorded it from a foster's report of an outside vet visit. It
  /// counts at once, as any other entry does: it only says where it came from.
  reportedByFoster Boolean @default(false) @map(name: "reported_by_foster")

  /// The foster's report of an outside vet visit this entry was recorded
  /// from. Provenance only, as `batchId` is. Null for care recorded any other
  /// way.
  vetReportId String?         @map(name: "vet_report_id")
  vetReport   VetVisitReport? @relation(fields: [vetReportId], references: [id], onDelete: Restrict)

  /// Voiding marks an entry that should never have been recorded: it is kept,
  /// but counts for nothing (it is left out of every derived fact, such as
  /// whether rabies is current). Write-once, as `Outcome.reversedAt` is:
  /// nothing clears `voidedAt`, so a void made in error is answered by
  /// recording the entry again, and the record still shows this one was
  /// voided, when, by whom and why. The reason is required whenever
  /// `voidedAt` is set.
  voidedAt   DateTime? @map(name: "voided_at")
  voidedById String?   @map(name: "voided_by_id")
  voidedBy   Person?   @relation("MedicalEntryVoidedBy", fields: [voidedById], references: [id])
  voidReason String?   @map(name: "void_reason")

  createdById String @map(name: "created_by_id")
  createdBy   Person @relation("MedicalEntryCreatedBy", fields: [createdById], references: [id])

  vaccine   VaccineDetails?
  test      TestDetails?
  treatment TreatmentDetails?
  surgery   SurgeryDetails?
  microchip MicrochipDetails?
  exam      ExamDetails?
  euthanasia EuthanasiaDetails?
  death      DeathDetails?
  events    MedicalEntryEvent[]

  /// On an exam: the spay or neuter it found already done, recorded from it.
  foundSurgery SurgeryDetails? @relation("SurgeryFoundOnExam")

  /// On a test or an exam: the problem-list conditions it found.
  conditionsFound MedicalCondition[] @relation("ConditionSourceEntry")

  /// The paperwork filed with this entry: a test's lab report, a surgery's
  /// discharge sheet.
  documents MedicalDocument[]

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@unique([chipNumber], where: { voidedAt: null })
  @@index([animalId, kind])
  @@index([animalId, procedure])
  @@index([itemId])
  @@index([status, dueDate])
  @@index([batchId])
  @@index([protocolStepId])
  @@index([vetReportId])
  @@map("medical_entries")
}

/// Clinical facts recorded with a euthanasia outcome. Authorization is a
/// recorded assertion, without a separate approval workflow. The performer
/// is either a Person or a name; services enforce that exactly one is set.
model EuthanasiaDetails {
  id      String       @id @default(cuid())
  entryId String       @unique @map(name: "entry_id")
  entry   MedicalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  reasonCategory EuthanasiaReasonCategory @map(name: "reason_category")
  reasonNotes    String? @map(name: "reason_notes")
  authorizedById String @map(name: "authorized_by_id")
  authorizedBy   Person @relation("EuthanasiaAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)
  performedById  String? @map(name: "performed_by_id")
  performedBy    Person? @relation("EuthanasiaPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)
  performedByName String? @map(name: "performed_by_name")

  /// Descriptive text, including the dose's unit; no inventory or dosing logic.
  drug String
  dose String
  route String
  witness String?
  bodyDisposition String? @map(name: "body_disposition")

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@map("euthanasia_details")
}

/// Facts recorded with a death outcome. Null cause and necropsy mean unknown;
/// an absent disposition is unknown too, rather than an invented fact.
model DeathDetails {
  id      String       @id @default(cuid())
  entryId String       @unique @map(name: "entry_id")
  entry   MedicalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  circumstances DeathCircumstances
  circumstanceNotes String? @map(name: "circumstance_notes")
  cause String?
  necropsyRequested Boolean? @map(name: "necropsy_requested")
  bodyDisposition String? @map(name: "body_disposition")

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@map("death_details")
}

/// What was given with a vaccine. Manufacturer and route start as the item's
/// defaults and are stored here, so changing the catalog never rewrites them.
model VaccineDetails {
  id      String       @id @default(cuid())
  entryId String       @unique @map(name: "entry_id")
  entry   MedicalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  manufacturer  String?
  lotNumber     String?       @map(name: "lot_number")
  lotExpiryDate String?       @map(name: "lot_expiry_date")
  route         MedicalRoute?
  site          String?

  /// Rabies only. `validUntilDate` is the completed day plus `durationMonths`,
  /// clamped to the end of the month, and null when the completed day is
  /// unknown. Only the entry service writes it, whenever either input changes.
  /// It's stored because it is printed on a certificate; whether rabies is
  /// valid today is still worked out when someone looks.
  rabiesTagNumber String? @map(name: "rabies_tag_number")
  durationMonths  Int?    @map(name: "duration_months")
  validUntilDate  String? @map(name: "valid_until_date")

  /// Recorded credentials, independent of the giver or later directory edits.
  veterinarianName          String? @map(name: "veterinarian_name")
  veterinarianLicenseNumber String? @map(name: "veterinarian_license_number")

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@map("vaccine_details")
}

/// The kit a test was run with, and one result per analyte the item reports.
model TestDetails {
  id      String       @id @default(cuid())
  entryId String       @unique @map(name: "entry_id")
  entry   MedicalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  lotNumber     String? @map(name: "lot_number")
  lotExpiryDate String? @map(name: "lot_expiry_date")

  results TestAnalyteResult[]

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@map("test_details")
}

/// One analyte's result. `analyteName` is the name frozen when the result was
/// written, so renaming the analyte in the catalog doesn't rewrite it.
model TestAnalyteResult {
  id            String             @id @default(cuid())
  testDetailsId String             @map(name: "test_details_id")
  testDetails   TestDetails        @relation(fields: [testDetailsId], references: [id], onDelete: Cascade)
  analyteId     String             @map(name: "analyte_id")
  analyte       MedicalItemAnalyte @relation(fields: [analyteId], references: [id], onDelete: Restrict)
  analyteName   String             @map(name: "analyte_name")
  result        TestResult

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@unique([testDetailsId, analyteId])
  @@map("test_analyte_results")
}

/// A one-off dose of a preventative, such as a dewormer. Courses of
/// medication are not treatments.
model TreatmentDetails {
  id      String       @id @default(cuid())
  entryId String       @unique @map(name: "entry_id")
  entry   MedicalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  doseAmount Float?        @map(name: "dose_amount")
  doseUnit   DoseUnit?     @map(name: "dose_unit")
  route      MedicalRoute?

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@map("treatment_details")
}

/// How a surgery went. The procedure is on the entry, since scheduled
/// surgery has no details row.
model SurgeryDetails {
  id      String       @id @default(cuid())
  entryId String       @unique @map(name: "entry_id")
  entry   MedicalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  /// Free text: the surgeon is rarely a person in the system.
  surgeon         String?
  findings        String?
  anesthesiaNotes String? @map(name: "anesthesia_notes")

  /// What shows a surgery done before intake was done. Required when the
  /// entry's source is BEFORE_INTAKE, and null for any other source.
  /// FOUND_ON_EXAM is set only on a surgery recorded from the exam that found
  /// it, and always with `foundOnExamId`.
  evidence SurgeryEvidence?

  /// The exam that found this spay or neuter already done. Set when the
  /// surgery is recorded from the exam, and kept as long as the surgery is:
  /// its source and evidence don't change while it is linked. Voiding the
  /// exam leaves the surgery and the link as they are. At most one surgery
  /// per exam.
  foundOnExamId String?       @unique @map(name: "found_on_exam_id")
  foundOnExam   MedicalEntry? @relation("SurgeryFoundOnExam", fields: [foundOnExamId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@map("surgery_details")
}

enum MicrochipRegistrationStatus {
  UNKNOWN
  NOT_REGISTERED
  PENDING
  REGISTERED
}

/// A microchip's details. The number is on the entry, so one index keeps
/// numbers unique among entries that aren't voided. Who implanted it is the
/// entry's source: in house, the shelter did; an outside vet did during the
/// stay; before intake, it was found on a scan.
model MicrochipDetails {
  id      String       @id @default(cuid())
  entryId String       @unique @map(name: "entry_id")
  entry   MedicalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  brand String?

  registrationStatus MicrochipRegistrationStatus @default(UNKNOWN) @map(name: "registration_status")
  registryName       String? @map(name: "registry_name")
  registrationDate   String? @map(name: "registration_date")
  registrationNotes  String? @map(name: "registration_notes")

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@map("microchip_details")
}

/// How an exam went. Its type is on the entry, since a scheduled exam has no
/// details row.
model ExamDetails {
  id      String       @id @default(cuid())
  entryId String       @unique @map(name: "entry_id")
  entry   MedicalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  overallResult ExamResult @map(name: "overall_result")

  /// Optional: not every exam looks. An exam reading INTACT is what makes an
  /// animal's spay/neuter status Intact; reading ALTERED, it records the
  /// surgery it found, since only a surgery entry makes an animal altered.
  reproductiveStatus ReproductiveStatus? @map(name: "reproductive_status")

  /// The vitals measured during the exam, when any were. The log is a normal
  /// vitals entry, written with the exam and from then on edited or deleted
  /// on the Vitals page; editing the exam doesn't touch it. Vitals are
  /// soft-deleted, so a deleted log still reads through this link.
  vitalsLogId String?    @unique @map(name: "vitals_log_id")
  vitalsLog   VitalsLog? @relation(fields: [vitalsLogId], references: [id], onDelete: SetNull)

  /// One per body system the exam was held to: the systems the code listed
  /// when it was recorded.
  findings ExamFinding[]

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@map("exam_details")
}

/// How one body system looked on an exam. The systems are defined in code,
/// and `bodySystem` holds a system's key: a string, not an enum, so a system
/// can be added without a migration. A key is never reused or repurposed.
model ExamFinding {
  id            String            @id @default(cuid())
  examDetailsId String            @map(name: "exam_details_id")
  examDetails   ExamDetails       @relation(fields: [examDetailsId], references: [id], onDelete: Cascade)
  bodySystem    String            @map(name: "body_system")
  status        ExamFindingStatus
  /// What was found. Required when the status is ABNORMAL.
  notes         String?

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@unique([examDetailsId, bodySystem])
  @@map("exam_findings")
}

/// Append-only audit trail for medical entries. `before` and `after` hold the
/// raw stored values, keyed by field name, of only the fields that changed;
/// detail fields use their own names (`lotNumber`) and test results use
/// `results`. CREATED stores the whole entry in `after`, its status included
/// (SCHEDULED or COMPLETED). COMPLETED stores `{ status }` in `before` and
/// everything recording it wrote in `after`; RESCHEDULED stores `{ dueDate }`
/// on both sides; DECLINED stores `{ status, declineReason }` in `after`; and
/// VOIDED stores `{ voidReason }`. An exam recorded with vitals adds
/// `vitalsLogId` to its CREATED or COMPLETED `after`; an edit never changes
/// it. Each event is also written to AnimalActivityLog as readable text for
/// the activity feed.
model MedicalEntryEvent {
  id      String                  @id @default(cuid())
  entryId String                  @map(name: "entry_id")
  entry   MedicalEntry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  action  MedicalEntryEventAction

  actorId String @map(name: "actor_id")
  actor   Person @relation("MedicalEntryEventActor", fields: [actorId], references: [id])

  before Json?
  after  Json?

  createdAt DateTime @default(now()) @map(name: "created_at")

  @@index([entryId])
  @@map("medical_entry_events")
}

/// What a row of an animal's problem list is: a condition, or an allergy.
enum MedicalConditionType {
  CONDITION
  ALLERGY
}

/// Where a problem-list row stands. Resolving one, or making it active
/// again, is a correction of its status: RESOLVED carries the day it
/// resolved, and ACTIVE and CHRONIC carry none.
enum MedicalConditionStatus {
  ACTIVE
  /// Lasting: managed rather than expected to resolve.
  CHRONIC
  RESOLVED
}

/// What a problem-list event records. Resolving and reactivating are edits.
enum MedicalConditionEventAction {
  CREATED
  EDITED
  VOIDED
}

/// What kind of care an episode is.
enum CareEpisodeType {
  /// Under a vet's care, wherever the animal is housed.
  UNDER_VET_CARE
  /// Hospitalised at the shelter.
  HOSPITALISED_IN_HOUSE
  /// Hospitalised at a vet clinic, which the episode names.
  HOSPITALISED_OFF_SITE
}

/// What a care-episode event records.
enum CareEpisodeEventAction {
  OPENED
  CLOSED
  EDITED
  VOIDED
}

/// One row of an animal's problem list: a condition or an allergy, active,
/// chronic or resolved. Its name is free text. It may name the test or exam
/// that found it, and the MEDICAL characteristic it stands for, which staff
/// can then add to the animal citing it.
///
/// A row is corrected in place, each change kept in its events, and resolving
/// or reactivating it is such a correction. A row recorded in error is
/// voided, as a medical entry is: kept, counting for nothing, and never
/// un-voided.
model MedicalCondition {
  id       String                 @id @default(cuid())
  animalId String                 @map(name: "animal_id")
  animal   Animal                 @relation(fields: [animalId], references: [id], onDelete: Cascade)
  type     MedicalConditionType
  name     String
  status   MedicalConditionStatus

  /// The calendar day it began, as `yyyy-MM-dd`, when known. It may be
  /// before intake: a condition the animal arrived with.
  onsetDate    String? @map(name: "onset_date")
  /// The calendar day it resolved, as `yyyy-MM-dd`. Set when the status is
  /// RESOLVED, and only then.
  resolvedDate String? @map(name: "resolved_date")
  /// Free text: whoever diagnosed it is rarely a person in the system.
  diagnosedBy  String? @map(name: "diagnosed_by")
  notes        String?

  /// The test or exam of this animal that found it: completed and not voided
  /// when the condition was written. Voiding that entry later leaves the
  /// link, so the condition still says where it came from.
  sourceEntryId String?       @map(name: "source_entry_id")
  sourceEntry   MedicalEntry? @relation("ConditionSourceEntry", fields: [sourceEntryId], references: [id], onDelete: SetNull)

  /// The MEDICAL characteristic it stands for, such as Heartworm Positive.
  /// While the condition is active or chronic, the trait can be added to the
  /// animal citing it.
  characteristicId String?         @map(name: "characteristic_id")
  characteristic   Characteristic? @relation(fields: [characteristicId], references: [id], onDelete: SetNull)

  /// Traits on the animal that cite this condition.
  citedBy AnimalCharacteristic[]

  /// Write-once, as on a medical entry: a voided row is kept but counts for
  /// nothing, and the reason is required whenever `voidedAt` is set.
  voidedAt   DateTime? @map(name: "voided_at")
  voidedById String?   @map(name: "voided_by_id")
  voidedBy   Person?   @relation("MedicalConditionVoidedBy", fields: [voidedById], references: [id])
  voidReason String?   @map(name: "void_reason")

  createdById String @map(name: "created_by_id")
  createdBy   Person @relation("MedicalConditionCreatedBy", fields: [createdById], references: [id])

  events MedicalConditionEvent[]

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@index([animalId])
  @@index([sourceEntryId])
  @@map("medical_conditions")
}

/// Append-only audit trail for the problem list, shaped as
/// `MedicalEntryEvent` is: `before` and `after` hold the raw stored values,
/// keyed by field name, of only the fields that changed. CREATED stores the
/// whole row in `after`, and VOIDED stores `{ voidReason }`. Each event is
/// also written to AnimalActivityLog as readable text.
model MedicalConditionEvent {
  id          String                      @id @default(cuid())
  conditionId String                      @map(name: "condition_id")
  condition   MedicalCondition            @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  action      MedicalConditionEventAction

  actorId String @map(name: "actor_id")
  actor   Person @relation("MedicalConditionEventActor", fields: [actorId], references: [id])

  before Json?
  after  Json?

  createdAt DateTime @default(now()) @map(name: "created_at")

  @@index([conditionId])
  @@map("medical_condition_events")
}

/// A stretch of days an animal was under care: under a vet's care,
/// hospitalised at the shelter, or hospitalised at a clinic. Always recorded,
/// never inferred from where the animal is housed: moving it into or out of a
/// medical unit only offers to open or close one.
///
/// Open while `endDate` is null. An animal has at most one open episode,
/// which the partial unique index backs, and its episodes don't overlap,
/// though one may start on the day the last one ended. A change of type
/// closes one episode and opens another. Corrected in place, each change kept
/// in its events, and voided (write-once) when recorded in error, as a
/// medical entry is.
model CareEpisode {
  id       String          @id @default(cuid())
  animalId String          @map(name: "animal_id")
  animal   Animal          @relation(fields: [animalId], references: [id], onDelete: Cascade)
  type     CareEpisodeType

  /// The calendar day it began, as `yyyy-MM-dd`: on or after the animal's
  /// latest intake, and not in the future.
  startDate String  @map(name: "start_date")
  /// The calendar day it ended, as `yyyy-MM-dd`, on or after `startDate`.
  /// Null while the episode is open.
  endDate   String? @map(name: "end_date")
  reason    String
  notes     String?

  /// The vet clinic: required for HOSPITALISED_OFF_SITE, optional for
  /// UNDER_VET_CARE (an outside vet's care), and never set for
  /// HOSPITALISED_IN_HOUSE.
  partnerId String?  @map(name: "partner_id")
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  openedById String  @map(name: "opened_by_id")
  openedBy   Person  @relation("CareEpisodeOpenedBy", fields: [openedById], references: [id])
  /// Who ended it: whoever last set `endDate`, and cleared when a correction
  /// reopens the episode.
  closedById String? @map(name: "closed_by_id")
  closedBy   Person? @relation("CareEpisodeClosedBy", fields: [closedById], references: [id])

  /// Write-once, as on a medical entry: a voided episode is kept but counts
  /// for nothing, and the reason is required whenever `voidedAt` is set.
  voidedAt   DateTime? @map(name: "voided_at")
  voidedById String?   @map(name: "voided_by_id")
  voidedBy   Person?   @relation("CareEpisodeVoidedBy", fields: [voidedById], references: [id])
  voidReason String?   @map(name: "void_reason")

  events CareEpisodeEvent[]

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@unique([animalId], where: { endDate: null, voidedAt: null })
  @@index([animalId])
  @@map("care_episodes")
}

/// Append-only audit trail for care episodes, shaped as `MedicalEntryEvent`
/// is. OPENED stores the whole episode in `after`; CLOSED stores `{ endDate }`
/// on both sides; VOIDED stores `{ voidReason }`. Each event is also written
/// to AnimalActivityLog as readable text.
model CareEpisodeEvent {
  id        String                 @id @default(cuid())
  episodeId String                 @map(name: "episode_id")
  episode   CareEpisode            @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  action    CareEpisodeEventAction

  actorId String @map(name: "actor_id")
  actor   Person @relation("CareEpisodeEventActor", fields: [actorId], references: [id])

  before Json?
  after  Json?

  createdAt DateTime @default(now()) @map(name: "created_at")

  @@index([episodeId])
  @@map("care_episode_events")
}

/// What a protocol step schedules. A vaccine, test or treatment names its
/// catalog item, and only these repeat. A spay/neuter becomes a spay or a
/// neuter by the animal's sex when the protocol is applied. An exam names its
/// type.
enum MedicalProtocolStepKind {
  VACCINE
  TEST
  TREATMENT
  SPAY_NEUTER
  EXAM
  MICROCHIP
}

/// The care an animal of one species, in an age range on its intake day, is
/// scheduled when it arrives. Managed by admins; applied once, at intake,
/// where it writes scheduled entries that then stand on their own: changing
/// or retiring a protocol never touches care it already scheduled.
///
/// Live protocols of one species never cover the same age, so at most one
/// fits an animal. The range is `[minAgeDays, maxAgeDays)` in whole days from
/// the birth day to the intake day; a null end is open. Retired, never
/// deleted, and retiring can be undone. Names are unique ignoring case, which
/// the service checks; the index only knows the exact spelling.
model MedicalProtocol {
  id         String  @id @default(cuid())
  name       String
  speciesId  String  @map(name: "species_id")
  species    Species @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  minAgeDays Int?    @map(name: "min_age_days")
  maxAgeDays Int?    @map(name: "max_age_days")

  steps MedicalProtocolStep[]

  retiredAt DateTime? @map(name: "retired_at")
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")

  @@unique([name])
  @@index([speciesId])
  @@map("medical_protocols")
}

/// One piece of care a protocol schedules, due `offsetDays` after intake and
/// not before the animal is `notBeforeAgeDays` old (nor before the day it is
/// applied). A repeating step schedules a dose every `repeatIntervalDays`,
/// `repeatCount` more times, or while the animal is under `untilAgeDays` on
/// the due day, or both; `untilAgeDays` alone keeps a single dose for the
/// young.
///
/// A saved step's care fields never change, so the entries that point at it
/// always show what was applied: an edit retires the step and adds a new one,
/// and only `sortOrder` is ever updated. Retired, never deleted.
model MedicalProtocolStep {
  id         String                  @id @default(cuid())
  protocolId String                  @map(name: "protocol_id")
  protocol   MedicalProtocol         @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  kind       MedicalProtocolStepKind

  /// The catalog item, for a vaccine, test or treatment step. Null otherwise.
  itemId String?      @map(name: "item_id")
  item   MedicalItem? @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// Which exam, on an EXAM step. Null otherwise.
  examType ExamType? @map(name: "exam_type")

  offsetDays         Int  @map(name: "offset_days")
  notBeforeAgeDays   Int? @map(name: "not_before_age_days")
  repeatIntervalDays Int? @map(name: "repeat_interval_days")
  repeatCount        Int? @map(name: "repeat_count")
  untilAgeDays       Int? @map(name: "until_age_days")

  /// Copied onto every entry the step schedules.
  notes String?

  sortOrder Int @map(name: "sort_order")

  entries MedicalEntry[]

  retiredAt DateTime? @map(name: "retired_at")
  createdAt DateTime  @default(now()) @map(name: "created_at")
  updatedAt DateTime  @updatedAt @map(name: "updated_at")

  @@index([protocolId])
  @@index([itemId])
  @@map("medical_protocol_steps")
}

/// How often a medication order expects a dose, and so which named slots it
/// expects each day: once a day the AM slot; twice a day AM and PM; three
/// times a day AM, Midday and PM; every few days the AM slot on the start day
/// and every `intervalDays` after it; as needed no slot at all, so nothing is
/// ever missed.
enum MedicationFrequency {
  SID
  BID
  TID
  EVERY_N_DAYS
  PRN
}

/// A named time of day a dose is due in. Each slot's window ends at a time
/// the shelter sets (`ShelterSettings`), read on the shelter's wall clock.
enum DoseSlot {
  AM
  MIDDAY
  PM
}

/// What happened when a dose was due. Refused and not given still account for
/// the slot: only a slot with no live dose is missed.
enum MedicationDoseResult {
  GIVEN
  REFUSED
  NOT_GIVEN
}

/// What an event on a medication order's audit trail records.
enum MedicationOrderEventAction {
  CREATED
  EDITED
  DISCONTINUED
  VOIDED
}

/// A course of a catalog medication for one animal: a dose, a route and a
/// frequency, from `startDate` through `endDate` (inclusive), or until it is
/// discontinued. It expects a dose in each of its frequency's slots on each
/// day it runs, from `firstSlot` on the start day; a discontinued order
/// expects none from `discontinuedDate` on, and a voided one none at all.
///
/// The medication, dose, unit, route and frequency never change: changing
/// them would rewrite what earlier doses and missed slots meant, so staff
/// discontinue the order and order again. Its state (upcoming, active, ended,
/// discontinued) is worked out on read from its days, never stored.
model MedicationOrder {
  id       String      @id @default(cuid())
  animalId String      @map(name: "animal_id")
  animal   Animal      @relation(fields: [animalId], references: [id], onDelete: Cascade)
  /// A `MEDICATION` catalog item. A retired one can't be ordered; orders that
  /// already name it keep it.
  itemId   String      @map(name: "item_id")
  item     MedicalItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  doseAmount   Float               @map(name: "dose_amount")
  doseUnit     DoseUnit            @map(name: "dose_unit")
  route        MedicalRoute
  frequency    MedicationFrequency
  /// Days between doses, 2 to 31, for EVERY_N_DAYS only, and always set then.
  intervalDays Int?                @map(name: "interval_days")

  /// The first day it runs, as `yyyy-MM-dd`: on or after the animal's latest
  /// intake. It may be in the past (an order recorded late) or the future.
  startDate String    @map(name: "start_date")
  /// Which of the frequency's slots is first due on the start day; the start
  /// day's earlier slots aren't expected. Null for PRN.
  firstSlot DoseSlot? @map(name: "first_slot")
  /// The last day it runs, inclusive, on or after `startDate`. Null runs
  /// until it is discontinued.
  endDate   String?   @map(name: "end_date")

  instructions String?
  prescribedBy String? @map(name: "prescribed_by")

  /// The first day it no longer runs: no slot on or after it is expected, and
  /// a dose already recorded on it stays. Set with a reason, once.
  discontinuedDate  String? @map(name: "discontinued_date")
  discontinueReason String? @map(name: "discontinue_reason")
  discontinuedById  String? @map(name: "discontinued_by_id")
  discontinuedBy    Person? @relation("MedicationOrderDiscontinuedBy", fields: [discontinuedById], references: [id])

  /// Write-once, as on a medical entry: a voided order and its doses are kept
  /// but count for nothing, and the reason is required whenever `voidedAt` is
  /// set.
  voidedAt   DateTime? @map(name: "voided_at")
  voidedById String?   @map(name: "voided_by_id")
  voidedBy   Person?   @relation("MedicationOrderVoidedBy", fields: [voidedById], references: [id])
  voidReason String?   @map(name: "void_reason")

  createdById String @map(name: "created_by_id")
  createdBy   Person @relation("MedicationOrderCreatedBy", fields: [createdById], references: [id])

  events MedicationOrderEvent[]
  doses  MedicationDose[]

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@index([animalId])
  @@index([itemId])
  @@map("medication_orders")
}

/// Append-only audit trail for medication orders, shaped as
/// `CareEpisodeEvent` is. CREATED stores the whole order in `after`; EDITED
/// stores only what changed on both sides; DISCONTINUED stores the day and
/// reason; VOIDED stores `{ voidReason }`. Each event is also written to
/// AnimalActivityLog as readable text.
model MedicationOrderEvent {
  id      String                     @id @default(cuid())
  orderId String                     @map(name: "order_id")
  order   MedicationOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action  MedicationOrderEventAction

  actorId String @map(name: "actor_id")
  actor   Person @relation("MedicationOrderEventActor", fields: [actorId], references: [id])

  before Json?
  after  Json?

  createdAt DateTime @default(now()) @map(name: "created_at")

  @@index([orderId])
  @@map("medication_order_events")
}

/// One dose recorded against an order: only doses someone recorded are
/// stored, and a slot with none is worked out on read. `slotDate` and `slot`
/// say which expected slot it accounts for (no slot for a PRN dose, of which
/// any number may be recorded on a day). A dose is never edited: a wrong one
/// is voided with a reason and the slot recorded again, so the row itself
/// holds who recorded it and who voided it.
model MedicationDose {
  id       String          @id @default(cuid())
  orderId  String          @map(name: "order_id")
  order    MedicationOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  animalId String          @map(name: "animal_id")
  animal   Animal          @relation(fields: [animalId], references: [id], onDelete: Cascade)

  /// The day of the slot it accounts for, as `yyyy-MM-dd`.
  slotDate String               @map(name: "slot_date")
  slot     DoseSlot?
  result   MedicationDoseResult
  /// Why it wasn't given: required for NOT_GIVEN, optional for REFUSED, null
  /// for GIVEN.
  reason   String?

  /// When it was given or tried: not before its slot day begins in the
  /// shelter's zone, and not in the future.
  administeredAt   DateTime @map(name: "administered_at")
  /// Who gave or tried it, as an entry's in-house giver.
  administeredById String   @map(name: "administered_by_id")
  administeredBy   Person   @relation("MedicationDoseAdministeredBy", fields: [administeredById], references: [id])
  notes            String?

  /// Provenance only: doses recorded together from the dose sheet share it.
  batchId String? @map(name: "batch_id")

  /// True when the animal's foster recorded the dose. It counts at once, as
  /// a dose staff record does: it only says who was there.
  reportedByFoster Boolean @default(false) @map(name: "reported_by_foster")

  /// Write-once: a voided dose is kept but counts for nothing, and the slot
  /// can be recorded again.
  voidedAt   DateTime? @map(name: "voided_at")
  voidedById String?   @map(name: "voided_by_id")
  voidedBy   Person?   @relation("MedicationDoseVoidedBy", fields: [voidedById], references: [id])
  voidReason String?   @map(name: "void_reason")

  createdById String @map(name: "created_by_id")
  createdBy   Person @relation("MedicationDoseCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@unique([orderId, slotDate, slot], where: { voidedAt: null })
  @@index([animalId, slotDate])
  @@map("medication_doses")
}

/// What kind of paper a medical document is. Defined in code: staff pick
/// one, and nothing derives from it beyond the label and the list's filter.
enum MedicalDocumentType {
  LAB_RESULT
  VET_RECORD
  IMAGING
  PRESCRIPTION
  CONSENT_FORM
  OTHER
}

/// What an event on a medical document's audit trail records.
enum MedicalDocumentEventAction {
  CREATED
  EDITED
  VOIDED
  FILE_REMOVED
}

/// A file kept on an animal's medical record: a lab result, a vet record, an
/// image, a prescription or a consent form. Optionally filed with one of the
/// animal's entries, and, when a foster sent it with a report of an outside
/// vet visit, naming that report.
///
/// The file is private. `pathname` is its key in the document store, never a
/// URL, and the file is served only through a route that checks who is
/// asking. The file is kept exactly as uploaded.
///
/// Corrected in place, each change kept in its events. Voiding (write-once)
/// keeps the row and the file: a voided document counts for nothing and
/// fosters don't see it. Removing the file, on a voided document only, deletes
/// it from the store for good and keeps the row, saying who removed it, when
/// and why: for a file the shelter should never have held.
model MedicalDocument {
  id       String @id @default(cuid())
  animalId String @map(name: "animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  /// The entry of the same animal this paper belongs to, if any.
  entryId String?       @map(name: "entry_id")
  entry   MedicalEntry? @relation(fields: [entryId], references: [id], onDelete: Restrict)

  /// The foster's report it was sent with, if any. Provenance only.
  vetReportId String?         @map(name: "vet_report_id")
  vetReport   VetVisitReport? @relation(fields: [vetReportId], references: [id], onDelete: Restrict)

  name         String
  type         MedicalDocumentType
  /// The calendar day on the paper (when the vet wrote it), as
  /// `yyyy-MM-dd`. Optional: not every paper is dated.
  documentDate String?             @map(name: "document_date")
  notes        String?

  /// The store's key for the file. Holds no part of the uploaded file's
  /// name, which can carry a person's name. Never shown.
  pathname    String @unique
  /// The type read from the file's first bytes when it was uploaded, never
  /// the name's extension or what the browser claimed.
  contentType String @map(name: "content_type")
  sizeBytes   Int    @map(name: "size_bytes")

  uploadedById String @map(name: "uploaded_by_id")
  uploadedBy   Person @relation("MedicalDocumentUploadedBy", fields: [uploadedById], references: [id])

  /// Write-once, as an entry's void is. The reason is required whenever
  /// `voidedAt` is set.
  voidedAt   DateTime? @map(name: "voided_at")
  voidedById String?   @map(name: "voided_by_id")
  voidedBy   Person?   @relation("MedicalDocumentVoidedBy", fields: [voidedById], references: [id])
  voidReason String?   @map(name: "void_reason")

  /// Set when the file was deleted from the store, on a voided document only.
  /// Write-once; the reason is required whenever `fileRemovedAt` is set.
  fileRemovedAt     DateTime? @map(name: "file_removed_at")
  fileRemovedById   String?   @map(name: "file_removed_by_id")
  fileRemovedBy     Person?   @relation("MedicalDocumentFileRemovedBy", fields: [fileRemovedById], references: [id])
  fileRemovalReason String?   @map(name: "file_removal_reason")

  events MedicalDocumentEvent[]

  /// When the file was uploaded.
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@index([animalId])
  @@index([entryId])
  @@index([vetReportId])
  @@map("medical_documents")
}

/// Append-only audit trail for medical documents, shaped as
/// `CareEpisodeEvent` is. CREATED stores the whole document in `after`;
/// EDITED stores only what changed on both sides; VOIDED stores
/// `{ voidReason }`; FILE_REMOVED stores `{ fileRemovalReason }`. Each event
/// is also written to AnimalActivityLog as readable text.
model MedicalDocumentEvent {
  id         String                     @id @default(cuid())
  documentId String                     @map(name: "document_id")
  document   MedicalDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  action     MedicalDocumentEventAction

  actorId String @map(name: "actor_id")
  actor   Person @relation("MedicalDocumentEventActor", fields: [actorId], references: [id])

  before Json?
  after  Json?

  createdAt DateTime @default(now()) @map(name: "created_at")

  @@index([documentId])
  @@map("medical_document_events")
}

/// A foster's report of a visit to an outside vet, sent under an open
/// placement: the day, the clinic (a vet clinic partner, or a vet's name),
/// what happened, and its paperwork as documents. It counts for nothing on
/// the record: staff record ordinary entries from it, which name it, then
/// mark it reviewed, or dismiss it with a reason.
///
/// Waiting while `reviewedAt` is null. Reviewing is write-once and needs no
/// entry: a visit can find nothing to record. A report stays after its
/// placement ends, still waiting until staff close it.
model VetVisitReport {
  id       String @id @default(cuid())
  animalId String @map(name: "animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  /// The placement it was sent under.
  placementId String          @map(name: "placement_id")
  placement   FosterPlacement @relation(fields: [placementId], references: [id], onDelete: Restrict)

  /// The foster who sent it.
  reportedById String @map(name: "reported_by_id")
  reportedBy   Person @relation("VetVisitReportReportedBy", fields: [reportedById], references: [id])

  /// The calendar day of the visit, as `yyyy-MM-dd`.
  visitDate String @map(name: "visit_date")

  /// The vet clinic partner seen, or a vet's name when it isn't a partner.
  vetPartnerId String?  @map(name: "vet_partner_id")
  vetPartner   Partner? @relation(fields: [vetPartnerId], references: [id])
  vetName      String?  @map(name: "vet_name")

  /// What happened at the visit, in the foster's words.
  summary String

  reviewedAt    DateTime? @map(name: "reviewed_at")
  reviewedById  String?   @map(name: "reviewed_by_id")
  reviewedBy    Person?   @relation("VetVisitReportReviewedBy", fields: [reviewedById], references: [id])
  /// Set only when the review dismissed the report, and required then.
  dismissReason String?   @map(name: "dismiss_reason")

  documents MedicalDocument[]
  entries   MedicalEntry[]

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")

  @@index([animalId])
  @@index([reviewedAt])
  @@map("vet_visit_reports")
}

// ═══════════════════════════════════════════════════
// ASSESSMENTS
// ═══════════════════════════════════════════════════
//
// Templates are code-defined: the source of truth is the typed registry in
// app/lib/assessments/templates.ts, mirrored into these tables by the seed so
// that assessments can hold a real foreign key. Template rows are
// NEVER edited in place — an admin edit writes a new row with `version + 1`
// under the same stable `key`, and the old row is retained and marked
// superseded. Answers carry both a field FK (for diffing/aggregation) and a
// frozen label+value snapshot (for history that cannot rot).

/// Triage signal for an assessment — says what to DO, not a grade.
/// Values are ordered least → most urgent so code can compare and escalate.
enum AssessmentSignal {
  NO_CONCERNS
  MONITOR
  FOLLOW_UP
  ESCALATE
}

/// The input control a template field renders as. Deliberately small — this is
/// structured staff data capture, not a form builder. `NUMBER`
/// answers are additionally stored in AssessmentAnswer.valueNumber for charting.
enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  SINGLE_SELECT
  MULTI_SELECT
  BOOLEAN
}

model AssessmentTemplate {
  id          String  @id @default(cuid())
  /// Stable identifier shared across every version of a template (e.g.
  /// "CAT_TEST"). `(key, version)` is the natural key the registry sync is
  /// idempotent on.
  key         String
  version     Int     @default(1)
  name        String
  description String?

  /// Species this template applies to, by `Species.name`. Null = all species.
  /// A plain string rather than a Species FK: the registry is code-defined and
  /// species-agnostic templates are the common case, so a nullable scalar keeps
  /// the sync a pure upsert with no lookup.
  species String?
  /// Optional free-text lifecycle-stage hint ("intake", "adoption-prep").
  /// Stage-based gating logic lives in the readiness code, not here.
  stage   String?

  isActive Boolean @default(true)

  /// Set when a newer version supersedes this row.
  /// The old row is retained, never edited or deleted — assessments point at
  /// the exact version they were recorded against.
  supersededById String?             @unique
  supersededBy   AssessmentTemplate? @relation("TemplateVersionChain", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     AssessmentTemplate? @relation("TemplateVersionChain")

  fields      AssessmentTemplateField[]
  assessments Assessment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, version])
  @@map("assessment_templates")
}

model AssessmentTemplateField {
  id         String             @id @default(cuid())
  templateId String
  template   AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  /// Stable identifier within the template. Answers match on this (via the FK
  /// below), so a label rename in a later version never orphans history.
  key              String
  label            String
  fieldType        FieldType
  /// Allowed values for SINGLE_SELECT / MULTI_SELECT, in display order. Empty
  /// for the free-text and numeric types.
  options          String[]
  /// Values drawn from `options` that raise the assessment's signal when
  /// selected. Empty where no single answer is inherently concerning.
  concerningValues String[]
  isRequired       Boolean   @default(false)
  order            Int

  /// When set, an answer of one of `proposesOnValues` on this field suggests
  /// assigning this characteristic to the animal — staff add or cite it from
  /// the assessment's own page, and a sourced assignment links back here via
  /// `AnimalCharacteristic.sourceAssessmentId`. Null for a field that sources
  /// no trait. Recorded answers are judged against this row, so the trait is
  /// matched by this id — renaming it in the catalog changes nothing.
  /// SetNull, not Cascade: retiring a catalog trait must not delete template
  /// history.
  proposesCharacteristicId String?
  proposesCharacteristic   Characteristic? @relation("CharacteristicProposedByFields", fields: [proposesCharacteristicId], references: [id], onDelete: SetNull)
  /// Subset of `options` that triggers the proposal above. Empty when nothing
  /// is proposed.
  proposesOnValues         String[]

  answers AssessmentAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, key])
  @@index([templateId])
  @@index([proposesCharacteristicId])
  @@map("assessment_template_fields")
}

model Assessment {
  id String @id @default(cuid())

  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  templateId String
  template   AssessmentTemplate @relation(fields: [templateId], references: [id])

  assessorId String
  assessor   Person @relation(fields: [assessorId], references: [id])

  /// When the observation was MADE (backdatable — same convention as
  /// VitalsLog.recordedAt). Distinct from createdAt, which is when the row was
  /// written.
  observedAt DateTime @default(now()) @map(name: "observed_at")

  signal  AssessmentSignal @default(NO_CONCERNS)
  summary String?

  answers AssessmentAnswer[]

  /// Characteristic assignments sourced from this assessment's findings.
  sourcedCharacteristics AnimalCharacteristic[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map(name: "deleted_at")

  @@index([animalId, observedAt])
  @@index([templateId])
  @@map("assessments")
}

model AssessmentAnswer {
  id String @id @default(cuid())

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// FK for diffing and cross-animal aggregation. Restrict, not SetNull: fields
  /// are never hard-deleted (a template edit is copy-on-write), so a
  /// dangling answer should never occur — enforce that rather than absorb it.
  templateFieldId String
  templateField   AssessmentTemplateField @relation(fields: [templateFieldId], references: [id])

  /// Frozen snapshot, written once and never rewritten. `questionLabel` is the
  /// field label as it read when recorded; `value` is the answer as recorded.
  questionLabel String
  value         String
  /// Parallel numeric column for charting NUMBER answers. Null for every other
  /// field type.
  valueNumber   Float?
  notes         String?

  createdAt DateTime @default(now())

  @@index([assessmentId])
  @@index([templateFieldId])
  @@map("assessment_answers")
}

// ═══════════════════════════════════════════════════
// ADOPTION WORKFLOW
// ═══════════════════════════════════════════════════

/// The review decisions: someone chose each one. Whether an adoption
/// application was adopted, or closed because its animal left the shelter, is
/// not a decision and is not stored here. It follows from the animal's
/// outcomes and is derived from them (`deriveApplicationStatus`).
enum ApplicationStatus {
  PENDING // Application submitted, awaiting review
  REVIEWING // Application is actively being reviewed
  WAITLISTED // A strong application, held as a backup for a specific animal OR approved in general, waiting for a suitable animal.
  APPROVED // Application approved
  REJECTED // Application rejected
  WITHDRAWN // Application withdrawn by the user
}

/// Who entered an application. Informational, for reviewers — never a
/// permission rule. A staff-entered snapshot was transcribed verbally at
/// intake, so it is *more* likely to contain errors than one the applicant
/// typed themselves, and the applicant is the only person who can correct
/// them; blocking their edit would lock the shelter's typos in.
enum ApplicationSource {
  SELF // Submitted by the applicant through the public flow
  STAFF // Entered by staff on behalf of an applicant, usually a walk-in
}

/// Represents a user's application to adopt a specific animal. This is a snapshot-in-time record.
model AdoptionApplication {
  id String @id @default(cuid())

  // Applicant details (snapshot in time for this specific application)
  applicantName         String  @map(name: "applicant_name")
  applicantEmail        String  @map(name: "applicant_email")
  applicantPhone        String  @map(name: "applicant_phone")
  applicantAddressLine1 String  @map(name: "applicant_address_line1")
  applicantAddressLine2 String? @map(name: "applicant_address_line2")
  applicantCity         String  @map(name: "applicant_city")
  applicantState        String  @map(name: "applicant_state")
  applicantZipCode      String  @map(name: "applicant_zip_code")

  // Home and lifestyle details
  livingSituation         LivingSituation @map(name: "living_situation")
  hasYard                 Boolean?        @map(name: "has_yard")
  landlordPermission      Boolean?        @map(name: "landlord_permission")
  householdSize           Int             @map(name: "household_size")
  hasChildren             Boolean?        @map(name: "has_children")
  childrenAges            Int[]           @map(name: "children_ages")
  otherAnimalsDescription String?         @map(name: "other_animals_description")
  animalExperience        String?         @map(name: "animal_experience")
  reasonForAdoption       String          @map(name: "reason_for_adoption")

  // Status and Workflow Management
  status        ApplicationStatus @default(PENDING)
  internalNotes String? // For persistent staff notes about the application as a whole

  /// Deliberately has no default: every create site must say which flow it
  /// came from, so a new one cannot silently claim to be self-submitted.
  source ApplicationSource

  /// Who last rewrote the applicant snapshot, and when. Written by the two
  /// snapshot-edit paths only — never by the status action — so unlike
  /// `updatedAt` (which a status change or an internalNotes edit also bumps)
  /// this is a clean signal that the text a reviewer read has since moved.
  lastEditedById String?   @map(name: "last_edited_by_id")
  lastEditedBy   Person?   @relation("AdoptionApplicationLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  lastEditedAt   DateTime? @map(name: "last_edited_at")

  outcomes        Outcome[]
  history         ApplicationStatusHistory[]
  fosterPlacement FosterPlacement?

  // Relations
  applicantId String @map(name: "applicant_id")
  applicant   Person @relation(fields: [applicantId], references: [id], onDelete: Restrict) // Prevent deleting a user with applications
  animalId    String @map(name: "animal_id")
  animal      Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  submittedAt DateTime @default(now()) @map(name: "submitted_at")
  updatedAt   DateTime @updatedAt @map(name: "updated_at")

  @@index([animalId])
  @@index([applicantId])
  @@index([status])
  @@index([animalId, status])
  @@map(name: "adoption_applications")
}

/// An adoption application's review decisions, in order: who moved it, when
/// and why. Only decisions are recorded here. The outcome that adopted or
/// closed an application appears in its timeline read off the outcome itself.
model ApplicationStatusHistory {
  id            String              @id @default(cuid())
  applicationId String              @map(name: "application_id")
  application   AdoptionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  status             ApplicationStatus // The status being set (e.g., APPROVED)
  statusChangeReason String // e.g., "Approved after a successful home visit." or a rejection reason.

  changedAt DateTime @default(now()) @map(name: "changed_at")

  changedById String? @map(name: "changed_by_id")
  changedBy   Person? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@map(name: "application_status_history")
}

// ═══════════════════════════════════════════════════
// FOSTERING WORKFLOW
// ═══════════════════════════════════════════════════

/// Represents a person's request to become an approved foster. This is a snapshot-in-time
/// record, same convention as `AdoptionApplication`, and moves through the same
/// review decisions (`ApplicationStatus`). Approval creates/activates the
/// `FosterProfile` from this application's capability snapshot.
model FosterApplication {
  id String @id @default(cuid())

  // Applicant details (snapshot in time for this specific application)
  applicantName         String  @map(name: "applicant_name")
  applicantEmail        String  @map(name: "applicant_email")
  applicantPhone        String  @map(name: "applicant_phone")
  applicantAddressLine1 String  @map(name: "applicant_address_line1")
  applicantAddressLine2 String? @map(name: "applicant_address_line2")
  applicantCity         String  @map(name: "applicant_city")
  applicantState        String  @map(name: "applicant_state")
  applicantZipCode      String  @map(name: "applicant_zip_code")

  // Home and lifestyle details (household snapshot, same convention as AdoptionApplication)
  livingSituation         LivingSituation @map(name: "living_situation")
  hasYard                 Boolean?        @map(name: "has_yard")
  landlordPermission      Boolean?        @map(name: "landlord_permission")
  householdSize           Int             @map(name: "household_size")
  hasChildren             Boolean?        @map(name: "has_children")
  childrenAges            Int[]           @map(name: "children_ages")
  otherAnimalsDescription String?         @map(name: "other_animals_description")
  animalExperience        String?         @map(name: "animal_experience")

  // Foster capability snapshot (mirrors FosterProfile's capability fields as submitted)
  maxAnimals          Int       @default(1) @map(name: "max_animals")
  hasQuarantineSpace  Boolean?  @map(name: "has_quarantine_space")
  canGiveOralMeds     Boolean?  @map(name: "can_give_oral_meds")
  canBottleFeed       Boolean?  @map(name: "can_bottle_feed")
  canTransport        Boolean?  @map(name: "can_transport")
  acceptsMedical      Boolean?  @map(name: "accepts_medical")
  acceptsHospice      Boolean?  @map(name: "accepts_hospice")
  availabilityNotes   String?   @map(name: "availability_notes")
  speciesCapabilities Species[] @relation("FosterApplicationSpeciesCapability")

  // Status and Workflow Management
  status        ApplicationStatus @default(PENDING)
  internalNotes String?

  history FosterApplicationStatusHistory[]

  personId String @map(name: "person_id")
  // Restrict: prevents deleting a Person with foster application history.
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  submittedAt DateTime @default(now()) @map(name: "submitted_at")
  updatedAt   DateTime @updatedAt @map(name: "updated_at")

  @@index([personId])
  @@index([status])
  @@map(name: "foster_applications")
}

model FosterApplicationStatusHistory {
  id            String            @id @default(cuid())
  applicationId String            @map(name: "application_id")
  application   FosterApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  status             ApplicationStatus // The status being set (e.g., APPROVED)
  statusChangeReason String // e.g., "Approved after a successful home visit." or a rejection reason.

  changedAt DateTime @default(now()) @map(name: "changed_at")

  changedById String? @map(name: "changed_by_id")
  changedBy   Person? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@map(name: "foster_application_status_history")
}

enum FosterPlacementType {
  GENERAL
  MEDICAL
  FOSTER_TO_ADOPT
  LONG_TERM
}

enum FosterReturnReason {
  RETURNED_TO_SHELTER
  ADOPTED_BY_FOSTER
  TRANSFERRED
  MEDICAL
  OTHER
  // Closed by an outcome recorded while the animal was in foster: it died,
  // was transferred out, or was adopted by someone other than the foster.
  // Only recording the outcome sets it; a return never does.
  ENDED_BY_OUTCOME
}

/// A dated event: this animal is with this foster for this window. NOT an outcome —
/// the animal remains in the shelter's care, a sibling of a location change rather
/// than of an outcome. "Currently in foster" is derived by checking for an open
/// placement (endDate == null), never stored as a flag.
model FosterPlacement {
  id   String              @id @default(cuid())
  type FosterPlacementType

  startDate       String    @map(name: "start_date")
  expectedEndDate String?   @map(name: "expected_end_date")
  endDate         String?   @map(name: "end_date")

  returnReason FosterReturnReason? @map(name: "return_reason")
  returnNotes  String?             @map(name: "return_notes")

  animalId String @map(name: "animal_id")
  // Restrict: placements are care history.
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  fosterProfileId String        @map(name: "foster_profile_id")
  // Restrict: placements are care history.
  fosterProfile   FosterProfile @relation(fields: [fosterProfileId], references: [id], onDelete: Restrict)

  // Informational only — the unit is NOT reserved while the animal is fostered.
  previousUnitId String? @map(name: "previous_unit_id")
  previousUnit   Unit?   @relation(fields: [previousUnitId], references: [id], onDelete: SetNull)

  // For FOSTER_TO_ADOPT: the animal's listingStatus before it was set to
  // PENDING_ADOPTION, restored if the placement ends without converting.
  previousListingStatus AnimalListingStatus? @map(name: "previous_listing_status")

  // Staff attribution, mirroring the Intake/Outcome staffMember convention.
  placedById String @map(name: "placed_by_id")
  placedBy   Person @relation("FosterPlacementPlacedBy", fields: [placedById], references: [id])

  returnedById String? @map(name: "returned_by_id")
  returnedBy   Person? @relation("FosterPlacementReturnedBy", fields: [returnedById], references: [id])

  // Optional link for FOSTER_TO_ADOPT conversions.
  adoptionApplicationId String?              @unique @map(name: "adoption_application_id")
  adoptionApplication   AdoptionApplication? @relation(fields: [adoptionApplicationId], references: [id], onDelete: SetNull)

  outcomeId String?  @unique @map(name: "outcome_id")
  outcome   Outcome? @relation(fields: [outcomeId], references: [id], onDelete: SetNull)

  // Outside vet visits the foster reported while this placement was open.
  vetVisitReports VetVisitReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // "One open placement per animal" (endDate == null) cannot be expressed as a
  // Prisma partial unique constraint — it is enforced in the action layer.
  @@index([animalId])
  @@index([fosterProfileId])
  @@map("foster_placements")
}

model Favorite {
  id String @id @default(cuid())

  animalId String @map(name: "animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  userId String @map(name: "user_id")
  user   Person @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, animalId])
  @@map(name: "favorites")
}

// ═══════════════════════════════════════════════════
// TASKS & NOTES
// ═══════════════════════════════════════════════════

enum TaskCategory {
  MEDICAL
  BEHAVIORAL
  ADMINISTRATIVE
  CLEANING
  FEEDING
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  SKIPPED // Task was skipped, not completed
  CANCELED
  ON_HOLD
  DELETED // Task is deleted but kept for records
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum NoteCategory {
  BEHAVIORAL
  MEDICAL
  FEEDING
  GENERAL
  ADOPTION_UPDATE
  FOSTER_UPDATE
}

enum NoteTargetType {
  ANIMAL
  PERSON
  PARTNER
}

enum NoteEventAction {
  CREATED
  EDITED
  DELETED
  RESTORED
}

model Task {
  id      String  @id @default(cuid())
  title   String
  details String?

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)
  category TaskCategory
  dueDate  String?      @map(name: "due_date") // Optional due date for the task (yyyy-MM-dd)

  animalId String @map(name: "animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  /// The staff member this task is assigned to. Can be null if it's a general task for any staff.
  assigneeId String? @map(name: "assignee_id")
  assignee   Person? @relation("TasksAssignedTo", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String @map("created_by_id")
  createdBy   Person @relation("TasksCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId])
  @@index([assigneeId])
  @@index([status])
  @@map(name: "tasks")
}

model AnimalNote {
  id       String       @id @default(cuid())
  category NoteCategory
  content  String

  animalId String @map(name: "animal_id")
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  authorId String? @map(name: "author_id")
  author   Person? @relation("AnimalNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  lastEditedById String?   @map(name: "last_edited_by_id")
  lastEditedBy   Person?   @relation("AnimalNoteLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  lastEditedAt   DateTime? @map(name: "last_edited_at")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map(name: "deleted_at")

  @@index([animalId])
  @@map(name: "animal_notes")
}

// Dated log of notes about a Person (e.g. "called 6/12, declined to foster").
model PersonNote {
  id      String @id @default(cuid())
  content String

  personId String @map(name: "person_id")
  person   Person @relation("PersonNoteSubject", fields: [personId], references: [id], onDelete: Cascade)

  authorId String? @map(name: "author_id")
  author   Person? @relation("PersonNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  lastEditedById String?   @map(name: "last_edited_by_id")
  lastEditedBy   Person?   @relation("PersonNoteLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  lastEditedAt   DateTime? @map(name: "last_edited_at")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map(name: "deleted_at")

  @@index([personId])
  @@map("person_notes")
}

// Dated log of notes about a Partner organization.
model PartnerNote {
  id      String @id @default(cuid())
  content String

  partnerId String  @map(name: "partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  authorId String? @map(name: "author_id")
  author   Person? @relation("PartnerNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  lastEditedById String?   @map(name: "last_edited_by_id")
  lastEditedBy   Person?   @relation("PartnerNoteLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  lastEditedAt   DateTime? @map(name: "last_edited_at")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? @map(name: "deleted_at")

  @@index([partnerId])
  @@map("partner_notes")
}

/// Append-only audit trail for note mutations across all three note types.
/// No content snapshots — records that an action happened, by whom, when.
/// Animal note events are ALSO written to AnimalActivityLog (the journey feed);
/// this table is the uniform per-note record and the only record for
/// person/partner notes.
model NoteEvent {
  id         String          @id @default(cuid())
  targetType NoteTargetType
  targetId   String          @map(name: "target_id")
  action     NoteEventAction

  actorId String @map(name: "actor_id")
  actor   Person @relation("NoteEventActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@map(name: "note_events")
}

// ═══════════════════════════════════════════════════
// ACTIVITY LOG
// ═══════════════════════════════════════════════════

enum AnimalActivityType {
  FIELD_UPDATE // A direct field on the animal model was changed (e.g., name, description)
  NOTE_ADDED // A note was created for this animal
  PHOTO_UPLOADED // A new photo was added
  ASSESSMENT_COMPLETED // An assessment was finished
  VITALS_RECORDED // A vitals entry (weight/temperature/body condition) was recorded
  TASK_CREATED // A task was created
  TASK_STATUS_CHANGED // A task's status was updated
  TASK_UPDATED // A task's fields were edited
  TASK_ASSIGNED // A task's assignee changed
  STATUS_CHANGE // The listing status changed
  INTAKE_PROCESSED // The initial intake event
  OUTCOME_PROCESSED // A final outcome event
  CREATED // The animal record itself was created
  LOCATION_CHANGE // The animal was moved to a different unit/location (or unplaced)
  FOSTER_PLACED // The animal was placed with a foster
  FOSTER_RETURNED // The animal was returned from a foster placement
  NOTE_EDITED // An existing note was edited
  NOTE_DELETED // A note was soft-deleted
  NOTE_RESTORED // A soft-deleted note was restored
  OUTCOME_CORRECTED // An existing outcome's date, notes, partner or owner was edited
  OUTCOME_REVERSED // An outcome was voided as recorded in error
  INTAKE_CORRECTED // An existing intake's date, type, source, found address or notes was edited
  MEDICAL_ENTRY_RECORDED // Medical care was recorded as given
  MEDICAL_ENTRY_EDITED // A recorded medical entry was corrected
  MEDICAL_ENTRY_VOIDED // A medical entry was voided as recorded in error
  MEDICAL_ENTRY_SCHEDULED // Medical care was scheduled for a due day
  MEDICAL_ENTRY_RESCHEDULED // A scheduled medical entry's due day moved
  MEDICAL_ENTRY_DECLINED // A scheduled medical entry was declined, with a reason
  MEDICAL_CONDITION_ADDED // A condition or allergy was added to the problem list
  MEDICAL_CONDITION_EDITED // A problem-list row was corrected, resolved or made active again
  MEDICAL_CONDITION_VOIDED // A problem-list row was voided as recorded in error
  CARE_EPISODE_OPENED // A care episode was opened (or recorded already ended)
  CARE_EPISODE_CLOSED // An open care episode was closed
  CARE_EPISODE_EDITED // A care episode was corrected
  CARE_EPISODE_VOIDED // A care episode was voided as recorded in error
  MEDICAL_PROTOCOL_APPLIED // A medical protocol scheduled care at intake: one row for every entry it wrote
  MEDICATION_ORDERED // A medication was ordered
  MEDICATION_ORDER_EDITED // A medication order was corrected
  MEDICATION_DISCONTINUED // A medication order was discontinued, with a reason
  MEDICATION_ORDER_VOIDED // A medication order was voided as recorded in error
  MEDICATION_DOSE_NOT_GIVEN // A dose was recorded as refused or not given (a dose given writes no row)
  MEDICATION_DOSE_VOIDED // A recorded dose was voided as recorded in error
  MEDICAL_DOCUMENT_ADDED // A medical document was uploaded
  MEDICAL_DOCUMENT_EDITED // A medical document's name, type, day, notes or entry was corrected
  MEDICAL_DOCUMENT_VOIDED // A medical document was voided as uploaded in error
  MEDICAL_DOCUMENT_FILE_REMOVED // A voided medical document's file was deleted from storage
  VET_VISIT_REPORTED // A foster reported an outside vet visit
  VET_VISIT_REPORT_REVIEWED // Staff marked a foster's vet visit report reviewed
  VET_VISIT_REPORT_DISMISSED // Staff dismissed a foster's vet visit report, with a reason
}

model AnimalActivityLog {
  id           String             @id @default(cuid())
  activityType AnimalActivityType

  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  changedById String
  changedBy   Person @relation(fields: [changedById], references: [id])

  changeSummary String?

  changedAt DateTime @default(now())

  @@map("animal_activity_logs")
}

// Forensic record of every AI-initiated mutation. It does NOT replace
// AnimalActivityLog: that stays the human-facing activity feed (animal-scoped,
// free-text summary, no before/after). An AI task change writes BOTH, in one
// transaction. This model carries what an audit undo path needs:
// the tool, the model-supplied input as received, before/after values, the
// actor, and the approval correlation ids.
model AiActionLog {
  id String @id @default(cuid())

  toolName   String
  // The AI SDK's tool-call id and approval id. Conversations are ephemeral,
  // so there is no conversationId/messageId to correlate against — these are.
  // approvalId is nullable: a mutation reached through a non-approval path (none
  // in v1) would have no approval to record. The unique constraint is what
  // makes an approval single-use: a replayed approval's insert hits it and the
  // whole transaction rolls back.
  toolCallId String
  approvalId String? @unique

  targetType AiActionTargetType
  targetId   String

  input  Json // the model-supplied tool input, as received — not the validated shape
  before Json
  after  Json

  actorId String @map("actor_id")
  actor   Person @relation(fields: [actorId], references: [id])

  undoneAt DateTime? @map("undone_at")

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@map("ai_action_logs")
}

enum AiActionTargetType {
  TASK
}

